---
// SSR Trending page (Phase 6 / Step 2). Ranked by the hourly cron-computed
// posts.trend_score (engagement decayed by age), read back via GET /trending.
// Replaces the mock-SPA TrendingPage. Prototype design (Shell + Grid).
import Shell from "../../layouts/Shell.astro";
import Grid from "../../components/Grid.astro";
import Pager from "../../components/Pager.astro";
import TrendingCatFilter from "../../components/TrendingCatFilter.astro";

const { locale } = Astro.params as { locale: string };
if (locale !== 'ja' && locale !== 'en') return new Response(null, { status: 404 });
const jp = locale === 'ja';

const url = new URL(Astro.request.url);
const page = Math.max(0, Number(url.searchParams.get('page')) || 0);
const cat = url.searchParams.get('cat') || '';
const LIMIT = 12;

const API = import.meta.env.DEV ? 'http://localhost:8787' : 'https://api.nihon101.com';
const [tRes, cRes] = await Promise.all([
  fetch(`${API}/trending?limit=${LIMIT}&page=${page}${cat ? `&cat=${encodeURIComponent(cat)}` : ''}`),
  fetch(`${API}/categories`),
]);
if (!tRes.ok || !cRes.ok) return new Response(null, { status: 502 });
const { posts, total } = await tRes.json();
const { categories } = await cRes.json();
const totalPages = Math.ceil(total / LIMIT);

const curCat = cat ? categories.find((c: any) => c.id === cat) : null;
const catLabel = curCat ? (jp ? curCat.labelJa : curCat.labelEn) : '';

// Keep the chosen category while paging.
const pageHrefBase = `/${locale}/trending?${cat ? `cat=${cat}&` : ''}page=`;
const pageTitle = jp ? '人気 — nihon101' : 'Trending — nihon101';
const pageDesc = jp ? 'いま読まれている記事。' : 'What people are reading right now.';
const canonical = `/${locale}/trending`;
---
<Shell locale={locale} title={pageTitle} description={pageDesc} canonicalPath={canonical} active="trending">
  <div class="wrap section">
    <div class="ex-kicker">
      <svg class="wave" viewBox="0 0 28 8"><path d="M1 4 Q 5 0, 9 4 T 17 4 T 27 4" stroke="var(--stamp)" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      {jp ? '人気' : 'Trending'}
    </div>
    <h1 class="ex">
      {curCat
        ? (jp ? `いま、${catLabel}で読まれているもの。` : `What people are reading in ${catLabel}.`)
        : (jp ? 'いま、読まれているもの。' : 'What people are reading now.')}
    </h1>
    <p class="ex-sub">{jp ? 'いまの勢い — 直近のいいね・コメント・閲覧から、毎分更新。' : 'Ranked by momentum — recent likes, comments and reads, updated by the minute.'}</p>

    <div class="list-bar">
      <div class="results-count">{String(total).padStart(2, '0')} {jp ? '件' : 'stories'}</div>
      <TrendingCatFilter categories={categories} current={cat} locale={locale} jp={jp} />
    </div>

    {posts.length === 0 ? (
      <div class="empty">
        <div class="mu">{curCat?.kanji || '無'}</div>
        <div class="msg">{curCat
          ? (jp ? `${catLabel}でいま話題の記事はまだありません。` : `Nothing trending in ${catLabel} yet.`)
          : (jp ? 'まだ何もありません。' : 'Nothing trending yet.')}</div>
      </div>
    ) : (
      <>
        <Grid posts={posts} categories={categories} locale={locale} />
        <Pager page={page} totalPages={totalPages} hrefBase={pageHrefBase} jp={jp} />
      </>
    )}
  </div>
</Shell>
