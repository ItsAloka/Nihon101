---
// SSR Privacy page — plain bilingual policy, no JS. Mirrors the About layout.
// Plain-language and honest about what's actually collected. AdSense-ready:
// discloses ad cookies + Google Ads Settings opt-out (2026-07-26).
import Shell from "../../layouts/Shell.astro";

const { locale } = Astro.params as { locale: string };
if (locale !== "ja" && locale !== "en") return new Response(null, { status: 404 });
const jp = locale === "ja";

const updated = "2026-07-26";
const sections = [
  { en: "What we collect", ja: "集めるもの",
    bodyEn: "When you register we store your email, display name, and (if you set them) your bio, location, and avatar. When you write, comment, react, follow, or report, we store those actions. If you sign in with Google, we store the link to your Google account — never your Google password.",
    bodyJa: "登録時に、メールアドレス・表示名・（設定した場合）プロフィール・場所・アバターを保存します。記事・コメント・リアクション・フォロー・通報も保存します。Googleでログインした場合は、Googleアカウントとの紐付けを保存します（Googleのパスワードは保存しません）。" },
  { en: "Why we collect it", ja: "なぜ集めるか",
    bodyEn: "Only to run the site: to show your posts, build your reading feed, send the emails you ask for (password reset, login codes, the newsletter you opt into), and keep the platform safe from abuse. We do not sell your data.",
    bodyJa: "サイトを動かすためだけです。記事の表示、フィードの作成、あなたが希望したメール（パスワード再設定・ログインコード・登録したニュースレター）の送信、不正利用の防止に使います。データを販売することはありません。" },
  { en: "Cookies", ja: "クッキー",
    bodyEn: "We use one essential cookie to keep you signed in (an HttpOnly session cookie) — the site can't work without it, so it needs no consent. Your theme and reading preferences are stored locally in your browser, not on our servers. If ads are enabled (see “Advertising” below), Google and its partners may also set advertising cookies.",
    bodyJa: "ログイン状態を保つための必須クッキー（HttpOnlyのセッションクッキー）を1つ使います。サイトの動作に不可欠なため、同意は不要です。テーマや表示設定はサーバーではなくブラウザ内に保存されます。広告が有効な場合（下記「広告について」参照）、Googleとそのパートナーが広告クッキーを設定することがあります。" },
  { en: "Advertising", ja: "広告について",
    bodyEn: "We may show ads served by Google AdSense to keep the site free. Google, as a third-party vendor, uses cookies (including web beacons) to serve ads based on your prior visits to this and other websites. You can opt out of personalised advertising at Google Ads Settings (adssettings.google.com), and visitors in the EU/UK will be asked for consent before any advertising cookies are set.",
    bodyJa: "サイトを無料で続けるために、Google AdSenseの広告を表示することがあります。第三者配信事業者であるGoogleは、このサイトや他のサイトへの過去のアクセスに基づいて広告を配信するため、クッキー（ウェブビーコンを含む）を使用します。パーソナライズ広告はGoogleの広告設定（adssettings.google.com）で無効にできます。EU/UKからの訪問者には、広告クッキーの設定前に同意を求めます。" },
  { en: "Who we share with", ja: "共有先",
    bodyEn: "A small set of service providers that make the site work: Cloudflare (hosting), our database host, Resend (transactional email), and Google (if you choose Google sign-in, and Google AdSense if ads are shown). Translations are generated by AI services at edit time. Each receives only what its job needs.",
    bodyJa: "サイトの運営に必要な少数の事業者とだけ共有します。Cloudflare（ホスティング）、データベースのホスト、Resend（メール送信）、Google（Googleログインを選んだ場合、および広告表示時のGoogle AdSense）。翻訳は編集時にAIサービスで生成されます。それぞれ、仕事に必要な情報だけを受け取ります。" },
  { en: "Your control", ja: "あなたの権限",
    bodyEn: "You can edit your profile any time, and you can delete your account from Settings — this removes your account and personal data. The newsletter always includes a one-click unsubscribe, and EU/UK visitors can change their ad-consent choice at any time via the consent banner.",
    bodyJa: "プロフィールはいつでも編集でき、設定からアカウントを削除できます（アカウントと個人データが削除されます）。ニュースレターには必ずワンクリックの配信停止が付きます。EU/UKからの訪問者は、同意バナーからいつでも広告への同意設定を変更できます。" },
  { en: "Contact", ja: "お問い合わせ",
    bodyEn: "Questions about your data? Use the contact form and we'll answer.",
    bodyJa: "データについてのご質問は、お問い合わせフォームからどうぞ。" },
];

const pageTitle = jp ? "プライバシー — nihon101" : "Privacy — nihon101";
const pageDesc = jp ? "どんなデータを、なぜ集めるか。" : "What data we collect, and why.";
---
<Shell locale={locale} title={pageTitle} description={pageDesc} canonicalPath={`/${locale}/privacy`} active="">
  <div class="wrap pv-wrap">
    <div class="ex-kicker">
      <svg class="wave" viewBox="0 0 28 8"><path d="M1 4 Q 5 0, 9 4 T 17 4 T 27 4" stroke="var(--stamp)" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      {jp ? "プライバシー" : "Privacy"}
    </div>
    <h1 class="pv-title">{jp ? "どんなデータを、なぜ。" : "What we collect, and why."}</h1>
    <p class="pv-lede">{jp ? "短く、正直に。読みやすさのために専門用語は省いています。" : "Short and honest. We've skipped the legalese for plain language."}</p>
    <p class="pv-updated">{jp ? `最終更新：${updated}` : `Last updated: ${updated}`}</p>

    {sections.map((s) => (
      <div class="pv-item">
        <h3 class="pv-h">{jp ? s.ja : s.en}</h3>
        <p class="pv-b">{jp ? s.bodyJa : s.bodyEn}</p>
      </div>
    ))}

    <a class="pv-cta" href={`/${locale}/contact`}>{jp ? "お問い合わせはこちら" : "Contact us"} →</a>
  </div>

  <style is:global>
    .pv-wrap { max-width: 760px; padding-top: 56px; padding-bottom: 64px; }
    .pv-title { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.025em; line-height: 1.05; color: var(--ink); margin: 12px 0 16px; }
    .pv-lede { font-family: var(--fontDisplay); font-style: italic; font-size: clamp(17px, 2.2vw, 21px); color: var(--inkSoft); line-height: 1.45; margin-bottom: 8px; }
    .pv-updated { font-family: var(--fontMono); font-size: 11px; color: var(--inkMeta); letter-spacing: 0.06em; margin-bottom: 40px; }
    .pv-item { margin-bottom: 28px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
    .pv-h { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(20px, 2.4vw, 26px); color: var(--ink); margin-bottom: 10px; }
    .pv-b { font-family: var(--fontBody); font-size: 15.5px; line-height: 1.7; color: var(--inkSoft); }
    .pv-cta { display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, var(--accent), var(--accentDeep)); color: #fff; padding: 12px 22px; border-radius: 999px; font-family: var(--fontBody); font-size: 14px; font-weight: 600; margin-top: 12px; }
  </style>
</Shell>
