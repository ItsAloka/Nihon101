---
// Public author profile (Phase 1, re-chromed + unified in Phase 3). Hero/stats come
// from /users/:handle; the story feed comes from the shared /search?author= endpoint
// so it gets the same sort + pagination + card style as every other list surface.
import Shell from "../../../layouts/Shell.astro";
import Grid from "../../../components/Grid.astro";
import SortBar from "../../../components/SortBar.astro";
import Pager from "../../../components/Pager.astro";
import { TINT_HEX } from "../../../lib/cards";
import { ssrFetch, fwdIp } from "../../../lib/ssr";
import FollowButton from "../../../nihon/FollowButton.jsx";
import FollowStats from "../../../nihon/FollowStats.jsx";

const { locale, handle } = Astro.params as { locale: string; handle: string };
if (locale !== 'ja' && locale !== 'en') return new Response(null, { status: 404 });
const jp = locale === 'ja';

const url = new URL(Astro.request.url);
const page = Math.max(0, Number(url.searchParams.get('page')) || 0);
const SORTS = ['new', 'top'];
let sort = url.searchParams.get('sort') || 'new';
if (!SORTS.includes(sort)) sort = 'new';
const LIMIT = 12;

const API = import.meta.env.DEV ? 'http://localhost:8787' : 'https://api.nihon101.com';
const fwd = { headers: fwdIp(Astro) };
const [profileRes, catsRes] = await Promise.all([
  ssrFetch(`${API}/users/${encodeURIComponent(handle)}`, fwd),
  ssrFetch(`${API}/categories`, fwd),
]);
if (!profileRes.ok) return new Response(null, { status: 404 });
const { user, stats } = await profileRes.json();
const { categories } = catsRes.ok ? await catsRes.json() : { categories: [] };

// Paginated/sorted story feed via the shared search endpoint (by author id).
const feedRes = await ssrFetch(`${API}/search?author=${encodeURIComponent(user.id)}&loc=${locale}&limit=${LIMIT}&page=${page}&sort=${sort}`, fwd);
const { posts, total } = feedRes.ok ? await feedRes.json() : { posts: [], total: 0 };
const totalPages = Math.ceil(total / LIMIT);

const TINTS = Object.values(TINT_HEX).slice(0, 9);
let h = 0;
for (const ch of user.handle) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const atint = TINTS[h % TINTS.length];
const initials = (user.displayName.trim().split(/\s+/).map((w: string) => w[0]).join('').slice(0, 3) || '?').toUpperCase();

const name = jp ? (user.displayNameJa || user.displayName) : user.displayName;
const altName = jp ? (user.displayNameJa ? user.displayName : '') : user.displayNameJa;
const bio = jp ? (user.bioJa || user.bio) : user.bio;
const dateFmt = (ms: number) =>
  new Date(ms).toLocaleDateString(jp ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const joined = dateFmt(user.joinedAt);

const sortHrefBase = `/${locale}/u/${user.handle}?sort=`;
const pageHrefBase = `/${locale}/u/${user.handle}?sort=${sort}&page=`;
const sortOptions = [{ label: jp ? '新着順' : 'Recent', value: 'new' }, { label: jp ? '人気順' : 'Most liked', value: 'top' }];
const pageTitle = `${name} — nihon101`;
const pageDesc = bio || (jp ? `${name}のnihon101プロフィール` : `${name} on nihon101`);
const canonical = `/${locale}/u/${user.handle}`;
---
<Shell locale={locale} title={pageTitle} description={pageDesc} canonicalPath={canonical} active="profile">
  <section class="pf-hero" style={`--atint:${atint};`}>
    {user.bannerUrl && (
      <>
        <img class="pf-banner" src={user.bannerUrl} alt="" aria-hidden="true" />
        <div class="pf-banner-scrim" aria-hidden="true"></div>
      </>
    )}
    <div class="wrap">
      <div class="pf-avatar">
        {user.avatarUrl ? <img src={user.avatarUrl} alt={user.displayName} /> : initials}
      </div>
      <div>
        <div class="pf-kicker">{user.role}{user.location ? ` · ${user.location}` : ''} · @{user.handle}</div>
        <h1 class="pf-name">{name}{altName && <span class="alt">{altName}</span>}</h1>
        {bio && <p class="pf-bio">{bio}</p>}
        <div class="pf-stats">
          <span><strong>{stats.published}</strong> {jp ? '記事' : 'published'}</span>
          <span>·</span>
          <span><strong>{stats.likes.toLocaleString()}</strong> {jp ? 'いいね' : 'likes'}</span>
          <span>·</span>
          <FollowStats client:only="react" handle={user.handle} locale={locale} followers={stats.followers ?? 0} following={stats.following ?? 0} />
          <span>·</span>
          <span>{jp ? `${joined}に参加` : `joined ${joined}`}</span>
        </div>
      </div>
      {/* Follow button — top-right of the hero, matching the prototype.
          Renders nothing for the owner. */}
      <div class="pf-follow-slot">
        <FollowButton client:only="react" handle={user.handle} locale={locale} variant="pink" showCount={true} />
      </div>
    </div>
  </section>

  <main class="wrap section">
    <div class="list-bar">
      <div class="results-count">{total === 0 ? (jp ? '該当なし' : 'No results') : `${String(total).padStart(2, '0')} ${jp ? '記事' : 'stories'}`}</div>
      {total > 0 && <SortBar current={sort} options={sortOptions} hrefBase={sortHrefBase} />}
    </div>

    {posts.length === 0 ? (
      <div class="empty"><div class="msg">{jp ? 'まだ記事がありません。' : 'No stories yet.'}</div></div>
    ) : (
      <>
        <Grid posts={posts} categories={categories} locale={locale} hideAuthor={true} />
        <Pager page={page} totalPages={totalPages} hrefBase={pageHrefBase} jp={jp} />
      </>
    )}
  </main>

  <style define:vars={{ atint }}>
    /* Tint gradient is the fallback; an uploaded banner covers it. The scrim keeps
       the name/bio legible over an arbitrary photo. */
    .pf-hero { position: relative; background: linear-gradient(135deg, color-mix(in oklab, var(--atint) 40%, var(--bg)), var(--bg)); border-bottom: 1px solid var(--line); }
    .pf-banner { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .pf-banner-scrim { position: absolute; inset: 0;
      background: linear-gradient(180deg, color-mix(in oklab, var(--bg) 45%, transparent), color-mix(in oklab, var(--bg) 78%, transparent)); }
    .pf-hero .wrap { position: relative; z-index: 1; padding: 64px 32px 52px; display: grid; grid-template-columns: auto 1fr auto; gap: 32px; align-items: center; }
    .pf-follow-slot { align-self: center; }
    .pf-avatar { width: 148px; height: 148px; border-radius: 50%; overflow: hidden; border: 1px solid var(--line); flex-shrink: 0;
      background: linear-gradient(135deg, var(--atint), color-mix(in oklab, var(--atint) 50%, var(--surface2)));
      display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 600; font-size: 56px; color: #3a2e28; }
    .pf-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .pf-kicker { font-family: var(--fontMono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--inkSoft); margin-bottom: 12px; }
    .pf-name { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(38px, 5vw, 64px); letter-spacing: -0.025em; line-height: 1; color: var(--ink); }
    .pf-name .alt { font-size: 0.42em; color: var(--stamp); margin-left: 18px; font-weight: 500; letter-spacing: 0; }
    .pf-bio { font-family: var(--fontDisplay); font-style: italic; font-size: 19px; color: var(--inkSoft); margin-top: 14px; max-width: 640px; line-height: 1.5; }
    .pf-stats { margin-top: 18px; display: flex; gap: 18px; font-family: var(--fontMono); font-size: 11px; color: var(--inkSoft); letter-spacing: 0.06em; text-transform: uppercase; }
    .pf-stats strong { color: var(--ink); }
    .pf-follow { appearance: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 22px; border-radius: 999px; font-family: var(--fontBody); font-size: 14px; font-weight: 600;
      border: 1px solid var(--stamp); background: var(--stamp); color: #fff; transition: background .15s, color .15s; }
    .pf-follow .plus { font-weight: 700; }
    .pf-follow[data-following="1"] { background: transparent; color: var(--ink); border-color: var(--line); }
    .pf-follow:disabled { opacity: .6; cursor: default; }
    .pf-followers { font-family: var(--fontMono); font-size: 11px; opacity: .85; padding-left: 8px; border-left: 1px solid color-mix(in oklab, currentColor 30%, transparent); }
    @media (max-width: 900px) {
      .pf-hero .wrap { grid-template-columns: auto 1fr; }
      /* Drop the follow button to a full-width row under the avatar+info. */
      .pf-follow-slot { grid-column: 1 / -1; justify-self: start; }
    }
    @media (max-width: 640px) {
      .pf-hero .wrap { grid-template-columns: 1fr; padding: 40px 16px 34px; gap: 18px; }
      .pf-avatar { width: 96px; height: 96px; }
      .pf-bio { font-size: 17px; }
      .pf-stats { flex-wrap: wrap; gap: 12px 16px; }
    }
  </style>
</Shell>
