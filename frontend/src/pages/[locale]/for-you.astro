---
// SSR For You page — the personalized feed at a clean /[locale]/for-you URL
// (replaces /app#/following). The feed body is a client island wrapping the
// existing FeedPage; the Shell provides the shared header/footer chrome.
import Shell from "../../layouts/Shell.astro";
import ForYouFeed from "../../nihon/ForYouFeed.jsx";

const { locale } = Astro.params as { locale: string };
if (locale !== 'ja' && locale !== 'en') return new Response(null, { status: 404 });
const jp = locale === 'ja';

const pageTitle = jp ? 'おすすめ — nihon101' : 'For You — nihon101';
const pageDesc = jp ? 'フォロー中の書き手、いま人気の記事、そしてあなたの好みから。' : 'Built from the writers you follow, what\'s trending, and the topics you read.';
---
<Shell locale={locale} title={pageTitle} description={pageDesc} canonicalPath={`/${locale}/for-you`} active="feed">
  <ForYouFeed client:only="react" locale={locale} />
</Shell>
