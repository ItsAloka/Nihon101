---
// SSR Writers directory (replaces the mock-SPA AuthorsPage). Every author with a
// published post, from GET /users (?sort=top|new, ?q= name search). A featured
// top-3 podium (trending writer score) leads the unfiltered page; a dedicated
// writer search filters the directory below. Each card links to the real SSR
// profile and carries a Follow button island. Prototype design tokens.
import Shell from "../../layouts/Shell.astro";
import Pager from "../../components/Pager.astro";
import SortBar from "../../components/SortBar.astro";
import { TINT_HEX } from "../../lib/cards";
import FollowButton from "../../nihon/FollowButton.jsx";

const { locale } = Astro.params as { locale: string };
if (locale !== 'ja' && locale !== 'en') return new Response(null, { status: 404 });
const jp = locale === 'ja';

const url = new URL(Astro.request.url);
const page = Math.max(0, Number(url.searchParams.get('page')) || 0);
const SORTS = ['top', 'new'];
let sort = url.searchParams.get('sort') || 'top';
if (!SORTS.includes(sort)) sort = 'top';
const rawQ = (url.searchParams.get('q') || '').trim();
const q = rawQ.slice(0, 80);
const searching = q.length >= 2;
const LIMIT = 24;

const API = import.meta.env.DEV ? 'http://localhost:8787' : 'https://api.nihon101.com';
const qs = new URLSearchParams({ sort, limit: String(LIMIT), page: String(page) });
if (searching) qs.set('q', q);
const res = await fetch(`${API}/users?${qs}`);
if (!res.ok) return new Response(null, { status: 502 });
const { authors, total, featured = [] } = await res.json();
const totalPages = Math.ceil(total / LIMIT);

// The podium leads page 1 of the unfiltered list; drop those 3 from the grid below
// so they don't appear twice. Searching or paging hides the podium entirely.
const showPodium = !searching && page === 0 && featured.length > 0;
const featuredIds = new Set(featured.map((f: any) => f.id));
const gridAuthors = showPodium ? authors.filter((a: any) => !featuredIds.has(a.id)) : authors;

const TINTS = Object.values(TINT_HEX).slice(0, 9);
const tintOf = (h: string) => { let n = 0; for (const c of h) n = (n * 31 + c.charCodeAt(0)) >>> 0; return TINTS[n % TINTS.length]; };
const initialsOf = (name: string) => (name.trim().split(/\s+/).map((w) => w[0]).join('').slice(0, 3) || '?').toUpperCase();
const nameOf = (a: any) => jp ? (a.displayNameJa || a.displayName) : a.displayName;
const followersLabel = (n: number) => jp ? `${n.toLocaleString()} フォロワー` : `${n.toLocaleString()} ${n === 1 ? 'follower' : 'followers'}`;

const sortHrefBase = `/${locale}/writers?sort=`;
const pageHrefBase = `/${locale}/writers?${searching ? `q=${encodeURIComponent(q)}&` : ''}sort=${sort}&page=`;
const sortOptions = [{ label: jp ? '人気順' : 'Most read', value: 'top' }, { label: jp ? '新着順' : 'Newest', value: 'new' }];
const pageTitle = jp ? '書く人 — nihon101' : 'Writers — nihon101';
const pageDesc = jp ? 'nihon101に書いている人たち。' : 'The people writing on nihon101.';
const canonical = `/${locale}/writers`;
const RANK_MEDAL = ['🥇', '🥈', '🥉'];
---
<Shell locale={locale} title={pageTitle} description={pageDesc} canonicalPath={canonical} active="authors">
  <div class="wrap section">
    <div class="ex-kicker">
      <svg class="wave" viewBox="0 0 28 8"><path d="M1 4 Q 5 0, 9 4 T 17 4 T 27 4" stroke="var(--stamp)" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      {jp ? '書く人' : 'Writers'}
    </div>
    <h1 class="ex">{jp ? '書いている人たち。' : 'The people behind the stories.'}</h1>
    <p class="ex-sub">{jp ? 'フォローすると、新しい記事がフィードに届きます。' : 'Follow a few — their new stories land in your For You feed.'}</p>

    {/* Dedicated writer search — submits as a plain GET so it works without JS and
        the results are fully SSR'd. */}
    <form class="wr-search" method="get" action={`/${locale}/writers`} role="search">
      <svg class="wr-search-ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input class="wr-search-in" type="search" name="q" value={searching ? q : ''} autocomplete="off"
        placeholder={jp ? '書く人を検索（名前・@ハンドル）' : 'Search writers by name or @handle'} />
      {searching && <a class="wr-search-clear" href={`/${locale}/writers`} aria-label={jp ? 'クリア' : 'Clear'}>×</a>}
    </form>

    {showPodium && (
      <section class="wr-podium" aria-label={jp ? '人気の書く人' : 'Top writers'}>
        {featured.map((a: any, i: number) => (
          <article class={`wr-feat r${i + 1}`} style={`--wtint:${tintOf(a.handle)};`}>
            <div class="wr-rank">{RANK_MEDAL[i]}<span>#{i + 1}</span></div>
            <a class="wr-feat-ava" href={`/${locale}/u/${a.handle}`}>
              {a.avatarUrl ? <img src={a.avatarUrl} alt={a.displayName} /> : initialsOf(a.displayName)}
            </a>
            <a class="wr-feat-name" href={`/${locale}/u/${a.handle}`}>{nameOf(a)}</a>
            <div class="wr-role">{a.role}{a.location ? ` · ${a.location}` : ''}</div>
            <div class="wr-feat-stats">
              <span><b>{a.postCount}</b> {jp ? '記事' : 'stories'}</span>
              <span><b>{a.likes.toLocaleString()}</b> {jp ? 'いいね' : 'likes'}</span>
              <span><b>{a.followers.toLocaleString()}</b> {jp ? 'フォロワー' : a.followers === 1 ? 'follower' : 'followers'}</span>
            </div>
            <FollowButton client:only="react" userId={a.id} handle={a.handle} locale={locale} showCount={false} />
          </article>
        ))}
      </section>
    )}

    <div class="list-bar">
      <div class="results-count">
        {searching
          ? (jp ? `「${q}」に一致：${total} 人` : `${total} ${total === 1 ? 'writer' : 'writers'} matching “${q}”`)
          : `${String(total).padStart(2, '0')} ${jp ? '人' : 'writers'}`}
      </div>
      {!searching && total > 0 && <SortBar current={sort} options={sortOptions} hrefBase={sortHrefBase} />}
    </div>

    {gridAuthors.length === 0 ? (
      <div class="wr-empty">{jp ? '一致する書く人が見つかりませんでした。' : 'No writers match that search.'}</div>
    ) : (
      <div class="wr-grid">
        {gridAuthors.map((a: any) => (
          <article class="wr-card" style={`--wtint:${tintOf(a.handle)};`}>
            <a class="wr-ava" href={`/${locale}/u/${a.handle}`}>
              {a.avatarUrl ? <img src={a.avatarUrl} alt={a.displayName} /> : initialsOf(a.displayName)}
            </a>
            <a class="wr-name" href={`/${locale}/u/${a.handle}`}>{nameOf(a)}</a>
            <div class="wr-role">{a.role}{a.location ? ` · ${a.location}` : ''}</div>
            <div class="wr-stats">{a.postCount} {jp ? '記事' : 'stories'} · {a.likes.toLocaleString()} {jp ? 'いいね' : 'likes'} · {followersLabel(a.followers)}</div>
            <FollowButton client:only="react" userId={a.id} handle={a.handle} locale={locale} showCount={false} />
          </article>
        ))}
      </div>
    )}

    <Pager page={page} totalPages={totalPages} hrefBase={pageHrefBase} jp={jp} />
  </div>

  <style is:global>
    /* ---- writer search ---- */
    .wr-search { position: relative; display: flex; align-items: center; margin: 18px 0 6px; max-width: 460px; }
    .wr-search-ic { position: absolute; left: 16px; width: 18px; height: 18px; color: var(--inkFaint); pointer-events: none; }
    .wr-search-in { width: 100%; height: 46px; padding: 0 40px 0 44px; border: 1px solid var(--line); border-radius: 999px;
      background: var(--surface); color: var(--ink); font-family: var(--fontBody); font-size: 14px; outline: none; transition: border-color .15s, box-shadow .15s; }
    .wr-search-in::placeholder { color: var(--inkFaint); }
    .wr-search-in:focus { border-color: var(--stamp); box-shadow: 0 0 0 3px color-mix(in oklab, var(--stamp) 18%, transparent); }
    .wr-search-in::-webkit-search-cancel-button { display: none; }
    .wr-search-clear { position: absolute; right: 14px; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center;
      border-radius: 50%; background: var(--surface2); color: var(--inkSoft); font-size: 16px; line-height: 1; text-decoration: none; }
    .wr-search-clear:hover { color: var(--ink); }

    /* ---- featured podium ---- */
    .wr-podium { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 14px 0 30px; }
    .wr-feat { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
      padding: 30px 18px 22px; border: 1.5px solid var(--line); border-radius: 22px;
      background: linear-gradient(180deg, color-mix(in oklab, var(--wtint) 16%, var(--surface)), var(--surface) 62%);
      transition: border-color .15s, transform .15s; }
    .wr-feat:hover { border-color: var(--stamp); transform: translateY(-2px); }
    .wr-feat.r1 { border-color: color-mix(in oklab, #e6b800 55%, var(--line)); }
    .wr-rank { position: absolute; top: 14px; left: 16px; display: flex; align-items: center; gap: 5px;
      font-family: var(--fontMono); font-size: 11px; color: var(--inkSoft); }
    .wr-rank span { letter-spacing: 0.04em; }
    .wr-feat-ava { width: 84px; height: 84px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, var(--wtint), color-mix(in oklab, var(--wtint) 50%, var(--surface2)));
      color: #3a2e28; font-family: var(--fontDisplay); font-weight: 600; font-size: 30px; border: 1px solid var(--line); margin: 2px 0 4px; }
    .wr-feat-ava img { width: 100%; height: 100%; object-fit: cover; }
    .wr-feat-name { font-family: var(--fontDisplay); font-weight: 600; font-size: 20px; color: var(--ink); letter-spacing: -0.01em; }
    .wr-feat-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px; margin: 4px 0 8px;
      font-family: var(--fontMono); font-size: 11px; color: var(--inkSoft); }
    .wr-feat-stats b { color: var(--ink); font-weight: 600; }

    /* ---- directory grid ---- */
    .wr-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 8px; }
    .wr-card { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
      padding: 24px 18px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface);
      transition: border-color .15s; }
    .wr-card:hover { border-color: var(--stamp); }
    .wr-ava { width: 72px; height: 72px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, var(--wtint), color-mix(in oklab, var(--wtint) 50%, var(--surface2)));
      color: #3a2e28; font-family: var(--fontDisplay); font-weight: 600; font-size: 26px; border: 1px solid var(--line); margin-bottom: 4px; }
    .wr-ava img { width: 100%; height: 100%; object-fit: cover; }
    .wr-name { font-family: var(--fontDisplay); font-weight: 600; font-size: 18px; color: var(--ink); letter-spacing: -0.01em; }
    .wr-role { font-family: var(--fontBody); font-size: 11px; color: var(--inkFaint); letter-spacing: 0.06em; text-transform: uppercase; }
    .wr-stats { font-family: var(--fontMono); font-size: 11px; color: var(--inkSoft); margin-bottom: 6px; }
    .wr-empty { padding: 48px 0; text-align: center; color: var(--inkSoft); font-family: var(--fontBody); font-size: 15px; }

    @media (max-width: 1000px) {
      .wr-grid { grid-template-columns: repeat(2, 1fr); }
      .wr-podium { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) { .wr-grid { grid-template-columns: 1fr; } }
  </style>
</Shell>
