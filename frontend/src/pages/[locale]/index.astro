---
// The real home page (Phase 2) — SSR body + the prototype's own chrome reused as
// two client islands (header/footer). Fed by GET /home. The hero is a carousel of
// the 3 newest "trending" posts (recency until the Phase 6 cron). The secondary
// feature + editor's reading list are recency-ranked stand-ins until the admin pick
// tool lands. The SPA (reader/composer/profile) lives at /{locale}/app.
import { HomeHeader, HomeFooter } from "../../nihon/home-chrome.jsx";

const { locale } = Astro.params as { locale: string };
if (locale !== 'ja' && locale !== 'en') return new Response(null, { status: 404 });
const jp = locale === 'ja';

const API = import.meta.env.DEV ? 'http://localhost:8787' : 'https://api.nihon101.com';
const res = await fetch(`${API}/home`);
if (!res.ok) throw new Error(`home: upstream ${res.status}`); // → branded 500.astro
const { hero, feature, picks, recent, categories, topAuthors, weather } = await res.json();
const heroSlides = (hero || []).filter(Boolean);
const catById = new Map(categories.map((c: any) => [c.id, c]));

// Tint gradients + subject glyphs — same maps the SPA uses (ui.jsx), copied so
// SSR needs no window globals. Fallback covers render as category-tint photos.
const TINT_GRAD: Record<string, [string, string]> = {
  rose: ['#FCCFD6', '#F58FA3'], amber: ['#FFE3A2', '#FFAA4F'], blue: ['#C4DCF6', '#7FA9DE'],
  lilac: ['#E2CCF2', '#B89BD9'], peach: ['#FFCFB0', '#F08D5C'], sage: ['#D4E4B0', '#9CB66D'],
  clay: ['#F2B59C', '#D17A5A'], mauve: ['#E5BBD2', '#BC7FA0'], sky: ['#C0DAF0', '#7FAFDC'],
  cream: ['#FFEFC8', '#FFCB7A'],
};
const GLYPH: Record<string, string> = {
  cream: '茶', amber: '麺', peach: '弁', blue: '雪', sky: '駅',
  lilac: '燈', rose: '桜', mauve: '香', sage: '葉', clay: '器',
};
const TINT_HEX: Record<string, string> = {
  rose: '#FBC5CC', amber: '#FFD27A', blue: '#A6C7F0', lilac: '#D6B8F0', peach: '#FBB58B',
  sage: '#B6D58E', clay: '#E89A7E', mauve: '#D89DBE', sky: '#9BC2EE', cream: '#FFE6B5',
};

const app = (hash: string) => `/${locale}/app${hash}`;
const read = (slug: string) => `/${locale}/p/${slug}`;      // SSR article reader
const writeHref = `/${locale}/write`;                        // SSR composer
const catHref = (id: string) => `/${locale}/c/${id}`;       // SSR category page (Phase 3)
const searchHref = `/${locale}/search`;                      // SSR explore page (Phase 3)
const title = (p: any) => (jp ? (p.titleJa || p.titleEn) : (p.titleEn || p.titleJa));
const excerpt = (p: any) => (jp ? (p.excerptJa || p.excerptEn) : (p.excerptEn || p.excerptJa));
const authorName = (p: any) => (jp ? (p.authorNameJa || p.authorName) : (p.authorName || p.authorNameJa)) || '—';
const catLabel = (id: string) => { const c: any = catById.get(id); return c ? (jp ? c.labelJa : c.labelEn) : id; };
const catKanji = (id: string) => { const c: any = catById.get(id); return (c && c.kanji) || ''; };
const catTint = (id: string) => { const c: any = catById.get(id); return (c && c.tint) || 'rose'; };
const grad = (id: string) => TINT_GRAD[catTint(id)] || TINT_GRAD.rose;
const glyphFor = (id: string) => GLYPH[catTint(id)] || '日';
const dateFmt = (msv: number) =>
  new Date(msv).toLocaleDateString(jp ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const initialsOf = (n: string) => (n.trim().split(/\s+/).map((w: string) => w[0]).join('').slice(0, 3) || '?').toUpperCase();
const tintOf = (handle: string) => {
  const tints = Object.values(TINT_HEX).slice(0, 9);
  let h = 0;
  for (const ch of handle || '') h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return tints[h % tints.length];
};
// Hero headline accent: underline the first two space-separated words (JA titles
// have no spaces, so the whole title gets the wash — same as the mock).
const washOf = (p: any) => {
  const words = title(p).split(' ');
  return { lead: words.slice(0, 2).join(' '), rest: words.slice(2).join(' ') };
};

// Masthead date — today's date, newspaper-style (paired with weather on the right).
const nowD = new Date();
const MONTHS_JP = ['睦月', '如月', '弥生', '卯月', '皐月', '水無月', '文月', '葉月', '長月', '神無月', '霜月', '師走'];
const MONTHS_EN = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const WEEKDAY_JP = ['日', '月', '火', '水', '木', '金', '土'];
const WEEKDAY_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const KANJI_DIGITS = ['〇', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
const kanjiYear = String(nowD.getFullYear()).split('').map((d) => KANJI_DIGITS[+d]).join('');
const kanjiDay = String(nowD.getDate()).split('').map((d) => KANJI_DIGITS[+d]).join('');
const mastheadJp = `${kanjiYear}年 ${MONTHS_JP[nowD.getMonth()]} ${kanjiDay}日 ${WEEKDAY_JP[nowD.getDay()]}曜日`;
const mastheadEn = `${WEEKDAY_EN[nowD.getDay()]}, ${nowD.getDate()} ${MONTHS_EN[nowD.getMonth()]} ${nowD.getFullYear()}`;

const topCats = categories.slice(0, 9);
const otherLocaleHref = `/${jp ? 'en' : 'ja'}/`;
const pageTitle = jp ? 'nihon101 — 日本101 | 日本を、ゆっくり読む' : 'nihon101 — 日本101 | slow stories from Japan';
const pageDesc = jp
  ? '文化、食、旅、言葉、アニメ、歴史。日本についての小さなバイリンガル雑誌。ゆっくり読んでください。'
  : 'A small bilingual magazine about Japan — culture, food, travel, language, animation, history. Read slowly.';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#D63752" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={`https://nihon101.com/${locale}/`} />
    <link rel="alternate" hreflang={jp ? 'en' : 'ja'} href={`https://nihon101.com${otherLocaleHref}`} />
    <link rel="alternate" hreflang={locale} href={`https://nihon101.com/${locale}/`} />
    <script is:inline>
      // Apply the saved theme before paint (no flash); the header island owns toggling.
      try { var __m = localStorage.getItem('nihon.mode') || 'light'; document.documentElement.dataset.mode = __m; document.documentElement.style.colorScheme = __m === 'dark' ? 'dark' : 'light'; } catch (e) {}
      // Legacy deep links from the old SPA hash router. Article reads now have a
      // real SSR URL (/{locale}/p/slug); send those straight there. Anything else
      // still lives in the app shell (/{locale}/app#…).
      if (location.hash.length > 2 && location.hash.startsWith('#/')) {
        var base = location.pathname.replace(/\/?$/, '');
        var art = location.hash.match(/^#\/article\/([^/?#]+)/);
        location.replace(art ? base + '/p/' + art[1] : base + '/app' + location.hash);
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Global block: these target the React header island's DOM (no astro scope) -->
    <style is:global>
      .nav-burger { display: none; }
      @keyframes navDrawerIn { from { transform: translateX(100%); } to { transform: none; } }
      @media (max-width: 820px) {
        .nihon-mainnav, .nihon-searchwrap, .nav-hide-mobile { display: none !important; }
        .nav-burger { display: inline-flex !important; }
      }
      @media (max-width: 820px) { .site-footer-grid { grid-template-columns: 1fr 1fr !important; gap: 28px !important; padding: 36px 16px 28px !important; } }
      @media (max-width: 440px) { .site-footer-grid { grid-template-columns: 1fr !important; } }
    </style>
    <style>
      :root {
        --bg: #fbfaf7; --surface: #fff; --surface2: #f2f0eb;
        --ink: #1a1817; --inkSoft: #5c544c; --inkFaint: #a39f98;
        --line: #ece8e0; --accent: #f58fa3; --accentDeep: #e54e70;
        --stamp: #d63752; --tint: #fce5ea;
        --fontDisplay: 'Shippori Mincho B1', 'Times New Roman', serif;
        --fontBody: 'Inter', 'Noto Sans JP', system-ui, sans-serif;
        --fontMono: 'JetBrains Mono', monospace;
      }
      /* Dark theme — mirrors deriveDark(hakuji) in ui.jsx so the SSR body matches
         the reused Nav/Footer islands exactly. */
      :root[data-mode="dark"] {
        --bg: color-mix(in oklab, #f58fa3 7%, #15121a);
        --surface: color-mix(in oklab, #f58fa3 6%, #1e1b24);
        --surface2: color-mix(in oklab, #f58fa3 10%, #2a2632);
        --ink: #f4efea; --inkSoft: #b9b0bc; --inkFaint: #7e7588;
        --line: color-mix(in oklab, #f58fa3 12%, #342f3c);
        --tint: color-mix(in oklab, #f58fa3 20%, #1e1b24);
        color-scheme: dark;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: var(--bg); color: var(--ink); font-family: var(--fontBody); -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; }
      ::selection { background: #f58fa3; color: #fff; }
      .wrap { max-width: 1320px; margin: 0 auto; padding: 0 32px; }
      .mono { font-family: var(--fontMono); letter-spacing: 0.1em; text-transform: uppercase; }

      /* issue ribbon */
      .ribbon { border-bottom: 1px solid var(--line); background: var(--surface); }
      .ribbon .wrap { padding: 10px 32px; display: flex; justify-content: space-between; font-family: var(--fontMono); font-size: 11px; color: var(--inkSoft); letter-spacing: 0.1em; text-transform: uppercase; }
      .ribbon .dot { width: 6px; height: 6px; border-radius: 3px; background: var(--stamp); display: inline-block; margin-right: 10px; }
      .ribbon-wx { display: inline-flex; align-items: center; }
      .ribbon-wx .ribbon-wx-text { transition: opacity 0.22s ease; text-transform: none; }

      /* hero */
      .hero { padding-top: 48px; padding-bottom: 16px; position: relative; }
      .hero-carousel { position: relative; }
      .hero-slide { display: none; }
      .hero-slide.active { display: block; animation: heroFade 0.5s ease; }
      @keyframes heroFade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; position: relative; }
      .hero-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
      .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; border: 1px solid var(--line); background: var(--surface); }
      .chip .kanji { font-family: var(--fontDisplay); color: var(--stamp); text-transform: none; letter-spacing: 0; }
      .hero-kicker { font-family: var(--fontMono); font-size: 11px; color: var(--inkFaint); letter-spacing: 0.1em; text-transform: uppercase; }
      h1 { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(44px, 5vw, 78px); line-height: 1.04; letter-spacing: -0.025em; margin-bottom: 24px; text-wrap: pretty; }
      h1 .wash { background-image: linear-gradient(transparent 70%, var(--accent) 70%, var(--accent) 92%, transparent 92%); background-repeat: no-repeat; padding-right: 0.1em; }
      .hero-excerpt { font-size: 18px; line-height: 1.55; color: var(--inkSoft); margin-bottom: 32px; max-width: 560px; }
      .hero-cta { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
      .read-btn { display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, var(--accent), var(--accentDeep)); color: #fff; padding: 14px 22px; border-radius: 999px; font-size: 14px; font-weight: 600; box-shadow: 0 12px 24px -10px var(--accentDeep); transition: transform 0.15s ease; }
      .read-btn:hover { transform: translateY(-1px); }
      .hero-save { appearance: none; border: 1px solid var(--line); background: var(--surface); width: 46px; height: 46px; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--ink); transition: transform 0.15s ease; }
      .hero-save:hover { transform: translateY(-1px); }
      .hero-save svg { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
      .hero-save.on svg { fill: var(--stamp); stroke: var(--stamp); }
      .achip { display: inline-flex; align-items: center; gap: 10px; }
      .achip .ava { border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 600; border: 1px solid var(--line); color: #3a2e28; overflow: hidden; flex-shrink: 0; }
      .achip .ava img { width: 100%; height: 100%; object-fit: cover; }
      .achip .nm { font-size: 13px; font-weight: 600; color: var(--ink); }
      .achip .dt { font-size: 11px; color: var(--inkFaint); }
      .hero-photo { position: relative; }
      .hero-photo .photo { border-radius: 24px; box-shadow: 0 40px 70px -50px color-mix(in oklab, var(--accentDeep) 60%, transparent); }
      .hero-photo .cover-hanko { border-radius: 16%; }
      .tategaki { position: absolute; left: -34px; top: 52px; writing-mode: vertical-rl; text-orientation: mixed; font-family: var(--fontDisplay); font-size: 14px; letter-spacing: 0.5em; color: var(--inkFaint); }

      /* hero carousel controls */
      .hero-controls { display: flex; align-items: center; justify-content: space-between; margin-top: 32px; }
      .hero-dots { display: flex; gap: 8px; }
      .hero-dot { width: 9px; height: 9px; border-radius: 50%; border: none; padding: 0; cursor: pointer; background: var(--line); transition: background 0.2s, width 0.2s; }
      .hero-dot.on { background: var(--accentDeep); width: 24px; border-radius: 5px; }
      .hero-arrows { display: flex; gap: 10px; }
      .hero-prev, .hero-next { appearance: none; border: 1px solid var(--line); background: var(--surface); width: 46px; height: 46px; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--ink); transition: transform 0.15s ease; }
      .hero-prev:hover, .hero-next:hover { transform: translateY(-1px); }
      .hero-prev svg, .hero-next svg { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

      /* photo placeholder (cover fallback) */
      .photo { position: relative; width: 100%; border-radius: 14px; overflow: hidden; display: block; }
      .photo .glyph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(90px, 22%, 240px); color: rgba(255, 255, 255, 0.6); line-height: 1; user-select: none; pointer-events: none; letter-spacing: -0.04em; }
      .photo img { width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0; }
      .photo .blob { position: absolute; right: -12%; top: -18%; width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, #fff 60%, transparent) 0%, transparent 70%); pointer-events: none; }
      .photo .vignette { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,0.35) 115%); opacity: 0.22; pointer-events: none; }
      .cover-hanko { position: absolute; top: 14px; right: 14px; width: 64px; height: 64px; border-radius: 14%; border: 2.5px solid var(--stamp); color: var(--stamp); display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 700; font-size: 29px; line-height: 1; transform: rotate(-6deg); letter-spacing: -0.04em; }
      .photo-tag { position: absolute; left: 14px; bottom: 12px; display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(6px); padding: 5px 10px; border-radius: 999px; font-family: var(--fontMono); font-size: 10px; letter-spacing: 0.08em; color: var(--inkSoft); text-transform: uppercase; }
      .photo-tag .dot { width: 6px; height: 6px; border-radius: 3px; background: var(--stamp); display: inline-block; }

      /* secondary + topics */
      .second-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 48px; margin-top: 64px; align-items: start; }
      .feature-card { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; background: var(--surface); border: 1.5px solid var(--line); padding: 24px; border-radius: 22px; align-items: stretch; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
      .feature-card:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--accent) 55%, var(--line)); box-shadow: 0 18px 30px -22px color-mix(in oklab, var(--accentDeep) 45%, transparent); }
      .feature-card .body { display: flex; flex-direction: column; justify-content: center; gap: 14px; }
      .feature-card .cmeta { display: flex; align-items: center; gap: 10px; }
      .feature-card h3 { font-family: var(--fontDisplay); font-weight: 600; font-size: 32px; line-height: 1.1; letter-spacing: -0.02em; text-wrap: pretty; }
      .feature-card p { font-size: 15px; line-height: 1.55; color: var(--inkSoft); }
      .rail { padding: 24px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; }
      .rail-kicker { font-family: var(--fontMono); font-size: 11px; color: var(--inkFaint); letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }
      .rail ul { list-style: none; display: flex; flex-direction: column; gap: 2px; margin-bottom: 18px; }
      .rail a.cat { display: flex; align-items: baseline; justify-content: space-between; padding: 10px 4px; border-bottom: 1px solid var(--line); font-family: var(--fontDisplay); font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
      .rail a.cat .kj { color: var(--stamp); font-size: 18px; margin-right: 10px; }
      .rail a.cat .ct { font-family: var(--fontMono); font-size: 11px; color: var(--inkFaint); letter-spacing: 0.06em; }
      .make-topic { padding: 16px; background: var(--tint); border-radius: 12px; display: flex; align-items: center; gap: 12px; position: relative; }
      .hanko { position: absolute; top: 8px; left: 12px; width: 42px; height: 42px; border-radius: 14%; border: 2.5px solid var(--stamp); color: var(--stamp); display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 700; font-size: 19px; transform: rotate(-8deg); }
      .make-topic .tx { flex: 1; margin-left: 58px; }
      .make-topic .t1 { font-family: var(--fontDisplay); font-weight: 600; font-size: 15px; margin-bottom: 2px; }
      .make-topic .t2 { font-size: 12px; color: var(--inkSoft); line-height: 1.4; }

      /* section headers */
      .sec-head { margin-top: 80px; margin-bottom: 28px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
      .sec-kicker { font-family: var(--fontMono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--inkFaint); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
      h2.sec { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(28px, 2.8vw, 40px); letter-spacing: -0.02em; line-height: 1.1; display: inline-flex; align-items: baseline; gap: 14px; }
      h2.sec .alt { font-size: 0.45em; color: var(--inkFaint); letter-spacing: 0.1em; }
      .see-all { font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }

      /* editor list */
      .editor-list { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
      .editor-list .num { font-family: var(--fontDisplay); font-size: 42px; font-weight: 600; color: var(--stamp); line-height: 0.9; min-width: 48px; letter-spacing: -0.04em; }
      .editor-list li { display: flex; gap: 16px; align-items: flex-start; background: var(--surface); border: 1.5px solid var(--line); border-radius: 22px; padding: 22px; transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease; }
      .editor-list li:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--accent) 55%, var(--line)); box-shadow: 0 18px 30px -22px color-mix(in oklab, var(--accentDeep) 45%, transparent); }
      .editor-list .cat { font-family: var(--fontMono); font-size: 10px; color: var(--inkFaint); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 6px; }
      .editor-list h3 { font-family: var(--fontDisplay); font-weight: 600; font-size: 22px; line-height: 1.15; letter-spacing: -0.015em; }
      .editor-list .ex { font-size: 14px; line-height: 1.55; color: var(--inkSoft); margin: 8px 0 10px; }

      /* recent grid */
      .recent-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
      .post-card { display: flex; flex-direction: column; gap: 12px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 22px; padding: 14px; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
      .post-card:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--accent) 55%, var(--line)); box-shadow: 0 18px 30px -22px color-mix(in oklab, var(--accentDeep) 45%, transparent); }
      .post-card .cmeta { display: flex; align-items: center; gap: 10px; }
      .post-card .mins { font-family: var(--fontMono); font-size: 11px; color: var(--inkFaint); letter-spacing: 0.06em; }
      .post-card h3 { font-family: var(--fontDisplay); font-weight: 600; font-size: 22px; line-height: 1.15; letter-spacing: -0.015em; text-wrap: pretty; }
      .post-card .ex { font-size: 14px; line-height: 1.55; color: var(--inkSoft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .post-card .foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); gap: 12px; }
      .post-card .stats { display: flex; align-items: center; gap: 14px; flex: none; }
      .post-card .stat { display: inline-flex; align-items: center; gap: 5px; font-family: var(--fontMono); font-size: 12.5px; font-weight: 600; color: var(--inkSoft); }
      .post-card .stat svg { width: 15px; height: 15px; }
      .post-card .stat.heart svg { fill: var(--stamp); }
      .post-card .stat.chat svg { fill: none; stroke: var(--inkFaint); stroke-width: 2; stroke-linejoin: round; }

      /* authors */
      .author-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; }
      .author-card { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; transition: transform 0.25s; }
      .author-card:hover { transform: translateY(-3px); }
      .author-card .ava { width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 600; font-size: 24px; border: 1px solid var(--line); color: #3a2e28; overflow: hidden; }
      .author-card .ava img { width: 100%; height: 100%; object-fit: cover; }
      .author-card .nm { font-family: var(--fontDisplay); font-weight: 600; font-size: 16px; line-height: 1.2; margin-bottom: 2px; }
      .author-card .rl { font-size: 11px; color: var(--inkFaint); letter-spacing: 0.08em; text-transform: uppercase; }
      .author-card .pc { font-family: var(--fontMono); font-size: 11px; color: var(--inkSoft); margin-top: 2px; }

      /* newsletter (capture now, sender later) */
      .newsletter { margin-top: 96px; padding: 56px; border-radius: 24px; background: linear-gradient(135deg, var(--tint), color-mix(in oklab, var(--tint) 60%, var(--surface))); border: 1px solid var(--line); position: relative; overflow: hidden; }
      .nl-inner { max-width: 600px; }
      .nl-inner .k { font-family: var(--fontMono); font-size: 11px; color: var(--inkSoft); letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 14px; }
      .nl-inner h2 { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 14px; }
      .nl-inner p { font-size: 16px; line-height: 1.6; color: var(--inkSoft); margin-bottom: 24px; }
      .nl-form { display: flex; gap: 10px; max-width: 520px; }
      .nl-form input { flex: 1; padding: 14px 18px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-family: var(--fontBody); font-size: 15px; color: var(--ink); outline: none; }
      .nl-form .btn { background: linear-gradient(135deg, var(--accent), var(--accentDeep)); color: #fff; padding: 14px 22px; border-radius: 999px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; white-space: nowrap; }
      .nl-form .btn:disabled { opacity: 0.6; cursor: default; }
      .nl-done { max-width: 520px; padding: 14px 18px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); font-family: var(--fontBody); font-size: 15px; color: var(--ink); line-height: 1.5; }
      .nl-note { margin-top: 14px; font-family: var(--fontMono); font-size: 11px; color: var(--inkFaint); letter-spacing: 0.06em; }
      .nl-hanko { position: absolute; top: 26px; right: 32px; width: 88px; height: 88px; border-radius: 14%; border: 2.5px solid var(--stamp); color: var(--stamp); display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 700; font-size: 40px; transform: rotate(-8deg); opacity: 0.85; }

      /* ---- responsive: tablet ---- */
      @media (max-width: 1024px) {
        .wrap { padding: 0 24px; }
        .ribbon .wrap { padding: 10px 24px; }
        .second-grid { gap: 32px; }
        .recent-grid, .editor-list { grid-template-columns: repeat(2, 1fr); gap: 24px; }
        .author-grid { grid-template-columns: repeat(3, 1fr); }
        .sec-head { margin-top: 64px; }
      }
      /* ---- responsive: collapse the two-column features ---- */
      @media (max-width: 860px) {
        .hero-grid, .second-grid, .feature-card { grid-template-columns: 1fr; gap: 28px; }
        .hero-photo { order: -1; }                       /* image above the headline on narrow screens */
        .hero-photo .photo { height: 320px !important; } /* beats the inline height */
        .feature-card .photo { height: 260px !important; }
        .tategaki { display: none; }
      }
      /* ---- responsive: phone ---- */
      @media (max-width: 640px) {
        .wrap { padding: 0 16px; }
        .ribbon .wrap { padding: 9px 16px; gap: 12px; }
        .ribbon .wrap span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .hero { padding-top: 28px; }
        .hero-photo .photo { height: 240px !important; }
        .recent-grid, .editor-list { grid-template-columns: 1fr; }
        .author-grid { grid-template-columns: repeat(2, 1fr); }
        .sec-head { margin-top: 52px; margin-bottom: 22px; flex-wrap: wrap; gap: 12px; }
        .feature-card { padding: 16px; }
        .newsletter { margin-top: 64px; padding: 32px 20px; }
        .nl-form { flex-direction: column; }
        .nl-hanko { width: 60px; height: 60px; font-size: 28px; top: 18px; right: 18px; }
      }
    </style>
  </head>
  <body>
    <HomeHeader client:load locale={locale} />

    <div class="ribbon">
      <div class="wrap">
        <span>{jp ? mastheadJp : mastheadEn}</span>
        <span class="ribbon-wx" data-wx={JSON.stringify(weather || [])} data-jp={jp ? '1' : '0'}>
          <span class="dot"></span>
          <span class="ribbon-wx-text">
            {weather && weather.length > 0
              ? `${weather[0].glyph} ${jp ? weather[0].ja : weather[0].en} ${weather[0].temp}° · ${jp ? weather[0].condJa : weather[0].condEn}`
              : (jp ? '今週も、ゆっくり読もう' : 'read slowly this week')}
          </span>
        </span>
      </div>
    </div>

    <!-- Hero carousel: the 3 newest "trending" posts, auto-cycling every 5s -->
    <section class="wrap hero">
      <div class="hero-carousel">
        {heroSlides.map((po: any, idx: number) => {
          const w = washOf(po);
          return (
          <div class={`hero-slide${idx === 0 ? ' active' : ''}`}>
            <div class="hero-grid">
              <div>
                <div class="hero-meta">
                  <a class="chip" href={catHref(po.categoryId)}>
                    <span class="kanji">{catKanji(po.categoryId)}</span>
                    {catLabel(po.categoryId)}
                  </a>
                  <span class="hero-kicker">{jp ? '特集' : 'cover story'} · {po.readMins} min</span>
                </div>
                <h1><span class="wash">{w.lead}</span>{w.rest ? ' ' + w.rest : ''}</h1>
                <p class="hero-excerpt">{excerpt(po)}</p>
                <div class="hero-cta">
                  <a class="achip" href={`/${locale}/u/${po.authorHandle}`}>
                    <span class="ava" style={`width:44px;height:44px;font-size:18px;background:linear-gradient(135deg, ${tintOf(po.authorHandle)}, #f2f0eb);`}>{po.authorAvatarUrl ? <img src={po.authorAvatarUrl} alt="" loading="lazy" /> : initialsOf(po.authorName || '?')}</span>
                    <span>
                      <span class="nm">{authorName(po)}</span><br />
                      <span class="dt">{dateFmt(po.publishedAt ?? po.createdAt)}</span>
                    </span>
                  </a>
                  <a class="read-btn" href={read(po.slug)}>{jp ? '読む' : 'Read the story'} →</a>
                  <button class="hero-save" data-slug={po.slug} type="button" aria-label="Save">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                  </button>
                </div>
              </div>
              <div class="hero-photo">
                <a class="photo" style={`height:520px;${po.cover ? '' : `background:linear-gradient(135deg, ${grad(po.categoryId)[0]}, ${grad(po.categoryId)[1]});`}`} href={read(po.slug)}>
                  {po.cover ? <img src={po.cover} alt={title(po)} /> : <span class="glyph">{glyphFor(po.categoryId)}</span>}
                  {!po.cover && <span class="blob"></span>}
                  <span class="vignette"></span>
                  <span class="cover-hanko">{catKanji(po.categoryId)}</span>
                  {po.coverLabel && <span class="photo-tag"><span class="dot"></span> photo: {po.coverLabel}</span>}
                </a>
                <div class="tategaki">日本の物語 · stories from japan</div>
              </div>
            </div>
          </div>
          );
        })}
      </div>

      {heroSlides.length > 1 && (
        <div class="hero-controls">
          <div class="hero-dots">
            {heroSlides.map((_: any, idx: number) => (
              <button class={`hero-dot${idx === 0 ? ' on' : ''}`} type="button" aria-label={`Slide ${idx + 1}`}></button>
            ))}
          </div>
          <div class="hero-arrows">
            <button class="hero-prev" type="button" aria-label="Previous">
              <svg width="18" height="18" viewBox="0 0 24 24"><path d="M19 12H5M11 5l-7 7 7 7"></path></svg>
            </button>
            <button class="hero-next" type="button" aria-label="Next">
              <svg width="18" height="18" viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
            </button>
          </div>
        </div>
      )}
    </section>

    <div class="wrap">
      <!-- Secondary feature (next newest post) + topics rail -->
      <section class="second-grid">
        {feature && (
          <div class="feature-card">
            <a class="photo" style={`height:340px;${feature.cover ? '' : `background:linear-gradient(135deg, ${grad(feature.categoryId)[0]}, ${grad(feature.categoryId)[1]});`}`} href={read(feature.slug)}>
              {feature.cover ? <img src={feature.cover} alt={title(feature)} loading="lazy" /> : <span class="glyph">{glyphFor(feature.categoryId)}</span>}
              {!feature.cover && <span class="blob"></span>}
              <span class="vignette"></span>
              {feature.coverLabel && <span class="photo-tag"><span class="dot"></span> photo: {feature.coverLabel}</span>}
            </a>
            <div class="body">
              <div class="cmeta">
                <a class="chip" href={catHref(feature.categoryId)}>
                  <span class="kanji">{catKanji(feature.categoryId)}</span>
                  {catLabel(feature.categoryId)}
                </a>
                <span class="hero-kicker">{jp ? 'もうひとつの特集' : 'also featured'}</span>
              </div>
              <a href={read(feature.slug)}><h3>{title(feature)}</h3></a>
              <p>{excerpt(feature)}</p>
              <a class="achip" href={`/${locale}/u/${feature.authorHandle}`}>
                <span class="ava" style={`width:32px;height:32px;font-size:13px;background:linear-gradient(135deg, ${tintOf(feature.authorHandle)}, #f2f0eb);`}>{feature.authorAvatarUrl ? <img src={feature.authorAvatarUrl} alt="" loading="lazy" /> : initialsOf(feature.authorName || '?')}</span>
                <span>
                  <span class="nm">{authorName(feature)}</span><br />
                  <span class="dt">{dateFmt(feature.publishedAt ?? feature.createdAt)}</span>
                </span>
              </a>
            </div>
          </div>
        )}

        <aside class="rail">
          <div class="rail-kicker">〜 {jp ? 'カテゴリー' : 'Topics'}</div>
          <ul>
            {topCats.map((c: any) => (
              <li>
                <a class="cat" href={catHref(c.id)}>
                  <span><span class="kj">{c.kanji}</span>{jp ? c.labelJa : c.labelEn}</span>
                  <span class="ct">{String(c.postCount).padStart(2, '0')}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="make-topic" href={writeHref}>
            <span class="hanko">新</span>
            <span class="tx">
              <span class="t1">{jp ? 'カテゴリーを作る' : 'Make a topic'}</span><br />
              <span class="t2">{jp ? 'あなたの主題で書き始める。' : 'Start writing under a topic of your own.'}</span>
            </span>
          </a>
        </aside>
      </section>

      <!-- Recently published (real) -->
      <div class="sec-head">
        <div>
          <div class="sec-kicker">〜 {jp ? 'すべての書き手から' : 'all writers · all topics'}</div>
          <h2 class="sec">{jp ? 'あたらしい記事' : 'Recently published'}<span class="alt">{jp ? 'Recently published' : 'あたらしい記事'}</span></h2>
        </div>
        <a class="see-all" href={searchHref}>{jp ? 'すべて見る' : 'See all'} →</a>
      </div>
      <div class="recent-grid">
        {recent.map((po: any) => (
          <article class="post-card">
            <a class="photo" style={`height:240px;${po.cover ? '' : `background:linear-gradient(135deg, ${grad(po.categoryId)[0]}, ${grad(po.categoryId)[1]});`}`} href={read(po.slug)}>
              {po.cover ? <img src={po.cover} alt={title(po)} loading="lazy" /> : <span class="glyph" style="font-size:84px;">{glyphFor(po.categoryId)}</span>}
              <span class="vignette"></span>
              {po.coverLabel && <span class="photo-tag"><span class="dot"></span> photo: {po.coverLabel}</span>}
            </a>
            <div class="cmeta">
              <a class="chip" href={catHref(po.categoryId)}>
                <span class="kanji">{catKanji(po.categoryId)}</span>
                {catLabel(po.categoryId)}
              </a>
              <span class="mins">{po.readMins} min</span>
            </div>
            <a href={read(po.slug)}><h3>{title(po)}</h3></a>
            <p class="ex">{excerpt(po)}</p>
            <div class="foot">
              <a class="achip" href={po.authorHandle ? `/${locale}/u/${po.authorHandle}` : read(po.slug)}>
                <span class="ava" style={`width:26px;height:26px;font-size:11px;overflow:hidden;background:linear-gradient(135deg, ${tintOf(po.authorHandle)}, #f2f0eb);`}>{po.authorAvatarUrl ? <img src={po.authorAvatarUrl} alt="" loading="lazy" /> : initialsOf(po.authorName || '?')}</span>
                <span>
                  <span class="nm" style="font-size:12.5px;">{authorName(po)}</span><br />
                  <span class="dt">{dateFmt(po.publishedAt ?? po.createdAt)}</span>
                </span>
              </a>
              <div class="stats">
                <span class="stat heart"><svg viewBox="0 0 24 24"><path d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z"></path></svg>{po.likes.toLocaleString()}</span>
                <span class="stat chat"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>{(po.comments ?? 0).toLocaleString()}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Writers in residence (top 15) -->
      <div class="sec-head">
        <div>
          <div class="sec-kicker">〜 {jp ? 'ここに書いている人' : 'meet the people'}</div>
          <h2 class="sec">{jp ? '書く人たち' : 'Writers in residence'}<span class="alt">{jp ? 'Writers in residence' : '書く人たち'}</span></h2>
        </div>
      </div>
      <div class="author-grid">
        {topAuthors.map((a: any) => (
          <a class="author-card" href={`/${locale}/u/${a.handle}`}>
            <span class="ava" style={a.avatarUrl ? '' : `background:linear-gradient(135deg, ${tintOf(a.handle)}, #f2f0eb);`}>
              {a.avatarUrl ? <img src={a.avatarUrl} alt={a.displayName} loading="lazy" /> : initialsOf(a.displayName)}
            </span>
            <span>
              <span class="nm">{jp ? (a.displayNameJa || a.displayName) : a.displayName}</span><br />
              <span class="rl">{a.location || '—'}</span>
            </span>
            <span class="pc">{String(a.postCount).padStart(2, '0')} {jp ? '記事' : 'pieces'}</span>
          </a>
        ))}
      </div>

      <!-- Newsletter — capture now (the Sunday letter sender ships later) -->
      <section class="newsletter">
        <div class="nl-hanko">便</div>
        <div class="nl-inner">
          <div class="k">{jp ? '毎週、おたより' : 'a slow weekly letter'}</div>
          <h2>{jp ? '日曜の朝に、一通だけ。' : 'One letter, every Sunday morning.'}</h2>
          <p>{jp ? '急がず、押し付けず。今週の三つの記事と、ひとつの小さな日本語の言葉を、お届けします。' : 'No urgency, no push. Three pieces from the week, and one small Japanese word we’ve been thinking about.'}</p>
          <form class="nl-form" id="nl-form" data-locale={locale}>
            <input type="email" name="email" required placeholder={jp ? 'メールアドレス' : 'you@somewhere.jp'} />
            <button class="btn" type="submit">{jp ? '登録する' : 'Subscribe'}</button>
          </form>
          <div class="nl-done" hidden>{jp ? 'リストに登録しました。日曜のおたよりは準備中です。' : "You're on the list — the Sunday letter is coming soon."}</div>
          <div class="nl-note">{jp ? '近日公開・スパムは送りません。' : 'Coming soon · no spam, ever.'}</div>
        </div>
      </section>
    </div>

    <HomeFooter client:load locale={locale} />

    <script>
      // Hero carousel — all slides are SSR'd; this only toggles which is visible.
      (function () {
        const hero = document.querySelector('.hero');
        const slides = Array.from(document.querySelectorAll('.hero-slide'));
        const dots = Array.from(document.querySelectorAll('.hero-dot'));
        let i = 0, timer = null;
        function show(n) {
          i = (n + slides.length) % slides.length;
          slides.forEach((s, k) => s.classList.toggle('active', k === i));
          dots.forEach((d, k) => d.classList.toggle('on', k === i));
        }
        function start() { stop(); if (slides.length > 1) timer = setInterval(() => show(i + 1), 5000); }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }
        const next = document.querySelector('.hero-next');
        const prev = document.querySelector('.hero-prev');
        if (next) next.addEventListener('click', () => { show(i + 1); start(); });
        if (prev) prev.addEventListener('click', () => { show(i - 1); start(); });
        dots.forEach((d, k) => d.addEventListener('click', () => { show(k); start(); }));
        if (hero) { hero.addEventListener('mouseenter', stop); hero.addEventListener('mouseleave', start); }
        start();

        // Hero bookmark clicks + initial state are wired by the HomeHeader island
        // (home-chrome.jsx), which has the session + backend client so a save
        // persists to post_saves and shows up on the Saved page. (Plain localStorage
        // here would never reach the backend — the cause of "saved posts vanish".)
      })();

      // Weather ribbon — cycle one city at a time (~6s). Data is SSR'd into a
      // data-attr, so no fetch here; it just rotates the already-loaded list.
      (function () {
        const el = document.querySelector('.ribbon-wx');
        const out = el && el.querySelector('.ribbon-wx-text');
        if (!el || !out) return;
        let cities = [];
        try { cities = JSON.parse(el.getAttribute('data-wx') || '[]'); } catch (e) { return; }
        if (!cities.length) return;
        const jp = el.getAttribute('data-jp') === '1';
        const fmt = (c) => `${c.glyph} ${jp ? c.ja : c.en} ${c.temp}° · ${jp ? c.condJa : c.condEn}`;
        let i = 0;
        setInterval(() => {
          i = (i + 1) % cities.length;
          out.style.opacity = '0';
          setTimeout(() => { out.textContent = fmt(cities[i]); out.style.opacity = ''; }, 220);
        }, 6000);
      })();
    </script>
  </body>
</html>
