---
// Clean-URL mount for the composer (replaces /{locale}/app#/compose). Edit mode
// is /{locale}/write?id=<postId>. Auth-gated inside the SPA. Private surface, so
// it mounts the existing App island (reads the screen from the pathname).
import SpaLayout from "../../layouts/SpaLayout.astro";

const { locale } = Astro.params;
if (locale !== "ja" && locale !== "en") return new Response(null, { status: 404 });
---

<SpaLayout lang={locale} syncLang />
