---
// Catch-all 404 for any unmatched route. Astro renders this with a 404 status in
// SSR. The path can be anything (/en/133, /foo, /), so we sniff the locale from the
// first URL segment (default ja, the site default) and render the matching language
// inside the normal Shell chrome so a lost reader still has the header + footer + nav.
import Shell from "../layouts/Shell.astro";

const path = Astro.url.pathname;
const seg = path.split("/").filter(Boolean)[0];
const locale = seg === "en" ? "en" : "ja";
const jp = locale === "ja";
Astro.response.status = 404;

const t = jp
  ? { kicker: "迷子", head: "そのページは、見つかりませんでした。", lede: "URL が変わったか、もう存在しないようです。お探しのものは、きっとどこかにあります。", home: "ホームへ戻る", explore: "記事をさがす", path: "たどったみち" }
  : { kicker: "Lost", head: "We couldn't find that page.", lede: "The URL may have changed, or it never existed. What you're looking for is probably still here somewhere.", home: "Back to home", explore: "Browse posts", path: "Path you followed" };

const pageTitle = jp ? "ページが見つかりません — nihon101" : "Page not found — nihon101";
---
<Shell locale={locale} title={pageTitle} description={t.lede} canonicalPath={`/${locale}`} active="">
  <div class="wrap nf-wrap">
    <div class="nf-hanko">迷</div>
    <div class="ex-kicker" style="justify-content:center;">
      <svg class="wave" viewBox="0 0 28 8"><path d="M1 4 Q 5 0, 9 4 T 17 4 T 27 4" stroke="var(--stamp)" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      404 · {t.kicker}
    </div>
    <h1 class="nf-title">{t.head}</h1>
    <p class="nf-lede">{t.lede}</p>

    <div class="nf-path">{t.path}: <code>{path}</code></div>

    <div class="nf-cta">
      <a class="nf-btn primary" href={`/${locale}`}>{t.home} →</a>
      <a class="nf-btn ghost" href={`/${locale}/search`}>{t.explore}</a>
    </div>
  </div>

  <!-- is:inline so the page is self-contained (see 500.astro for the why): Astro
       externalizes is:global into a bundled CSS link that error-render paths can drop,
       leaving the page unstyled. Inline styles always render. Re-declares the tokens. -->
  <style is:inline>
    :root { --bg:#fbfaf7; --surface:#fff; --surface2:#f2f0eb; --ink:#1a1817; --inkSoft:#5c544c; --inkFaint:#a39f98; --line:#ece8e0; --accent:#f58fa3; --accentDeep:#e54e70; --stamp:#d63752; --tint:#fce5ea; --fontDisplay:'Shippori Mincho B1','Times New Roman',serif; --fontBody:'Inter','Noto Sans JP',system-ui,sans-serif; --fontMono:'JetBrains Mono',monospace; }
    :root[data-mode="dark"] { --bg:color-mix(in oklab,#f58fa3 7%,#15121a); --surface:color-mix(in oklab,#f58fa3 6%,#1e1b24); --surface2:color-mix(in oklab,#f58fa3 10%,#2a2632); --ink:#f4efea; --inkSoft:#b9b0bc; --inkFaint:#7e7588; --line:color-mix(in oklab,#f58fa3 12%,#342f3c); --tint:color-mix(in oklab,#f58fa3 20%,#1e1b24); color-scheme:dark; }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:var(--bg); color:var(--ink); font-family:var(--fontBody); -webkit-font-smoothing:antialiased; }
    a { color:inherit; text-decoration:none; }
    .wrap { max-width:1320px; margin:0 auto; padding:0 32px; }
    .ex-kicker { font-family:var(--fontMono); font-size:11px; color:var(--inkMeta); letter-spacing:0.18em; text-transform:uppercase; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .nf-wrap { max-width: 680px; padding-top: 80px; padding-bottom: 96px; text-align: center; }
    .nf-hanko { width: 104px; height: 104px; margin: 0 auto 28px; border-radius: 16%; border: 3px solid var(--stamp); color: var(--stamp); display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 700; font-size: 52px; transform: rotate(-6deg); }
    .nf-title { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(34px, 5vw, 60px); letter-spacing: -0.025em; line-height: 1.08; color: var(--ink); margin: 6px 0 18px; text-wrap: pretty; }
    .nf-lede { font-family: var(--fontDisplay); font-style: italic; font-size: clamp(17px, 2.2vw, 21px); color: var(--inkSoft); line-height: 1.5; margin: 0 auto 32px; max-width: 520px; }
    .nf-path { font-family: var(--fontMono); font-size: 12px; color: var(--inkMeta); letter-spacing: 0.06em; margin-bottom: 36px; }
    .nf-path code { background: var(--surface2); padding: 3px 9px; border-radius: 8px; color: var(--inkSoft); }
    .nf-cta { display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .nf-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 999px; font-family: var(--fontBody); font-size: 14px; font-weight: 600; }
    .nf-btn.primary { background: linear-gradient(135deg, var(--accent), var(--accentDeep)); color: #fff; }
    .nf-btn.ghost { border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
    .nf-btn.ghost:hover { border-color: var(--accent); }
  </style>
</Shell>
