---
// Branded 500 for any uncaught SSR error — most often the backend API being
// unreachable while a page server-fetches it. Astro renders this (with a 500
// status) instead of a blank page. Locale sniffed from the first path segment
// (default ja). Kept dependency-free: it must render even when the API is down.
import Shell from "../layouts/Shell.astro";

const path = Astro.url.pathname;
const seg = path.split("/").filter(Boolean)[0];
const locale = seg === "en" ? "en" : "ja";
const jp = locale === "ja";

const t = jp
  ? { kicker: "ごめんなさい", head: "うまく読み込めませんでした。", lede: "一時的な問題のようです。少し待ってから、もう一度お試しください。", retry: "再読み込み", home: "ホームへ戻る" }
  : { kicker: "Sorry", head: "Something went wrong on our side.", lede: "This looks like a temporary hiccup. Give it a moment, then try again.", retry: "Try again", home: "Back to home" };

const pageTitle = jp ? "問題が発生しました — nihon101" : "Something went wrong — nihon101";
---
<Shell locale={locale} title={pageTitle} description={t.lede} canonicalPath={`/${locale}`} active="">
  <div class="wrap er-wrap">
    <div class="er-hanko">詫</div>
    <div class="ex-kicker" style="justify-content:center;">
      <svg class="wave" viewBox="0 0 28 8"><path d="M1 4 Q 5 0, 9 4 T 17 4 T 27 4" stroke="var(--stamp)" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      500 · {t.kicker}
    </div>
    <h1 class="er-title">{t.head}</h1>
    <p class="er-lede">{t.lede}</p>

    <div class="er-cta">
      <a class="er-btn primary" href={path} data-er-retry>{t.retry} ↻</a>
      <a class="er-btn ghost" href={`/${locale}`}>{t.home}</a>
    </div>
  </div>

  <style is:global>
    .er-wrap { max-width: 680px; padding-top: 80px; padding-bottom: 96px; text-align: center; }
    .er-hanko { width: 104px; height: 104px; margin: 0 auto 28px; border-radius: 16%; border: 3px solid var(--stamp); color: var(--stamp); display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 700; font-size: 52px; transform: rotate(-6deg); }
    .er-title { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(34px, 5vw, 60px); letter-spacing: -0.025em; line-height: 1.08; color: var(--ink); margin: 6px 0 18px; text-wrap: pretty; }
    .er-lede { font-family: var(--fontDisplay); font-style: italic; font-size: clamp(17px, 2.2vw, 21px); color: var(--inkSoft); line-height: 1.5; margin: 0 auto 32px; max-width: 520px; }
    .er-cta { display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .er-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 999px; font-family: var(--fontBody); font-size: 14px; font-weight: 600; }
    .er-btn.primary { background: linear-gradient(135deg, var(--accent), var(--accentDeep)); color: #fff; }
    .er-btn.ghost { border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
    .er-btn.ghost:hover { border-color: var(--accent); }
  </style>
</Shell>
