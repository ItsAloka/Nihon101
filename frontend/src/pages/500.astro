---
// Branded 500 — must render even when the API is down (no external deps).
// Matches the 404 page style exactly: hanko stamp + wave kicker + serif title.
import Shell from "../layouts/Shell.astro";

const path = Astro.url.pathname;
const seg = path.split("/").filter(Boolean)[0];
const locale = seg === "en" ? "en" : "ja";
const jp = locale === "ja";

const t = jp
  ? { kicker: "一時的な問題", head: "うまく読み込めませんでした。", lede: "サーバー側で何かが起きているようです。少し待ってから、もう一度お試しください。", retry: "再読み込み ↻", home: "ホームへ戻る" }
  : { kicker: "Server error", head: "Something went wrong on our side.", lede: "This looks like a temporary hiccup. Give it a moment, then try again.", retry: "Try again ↻", home: "Back to home" };

const pageTitle = jp ? "問題が発生しました — nihon101" : "Something went wrong — nihon101";
---
<Shell locale={locale} title={pageTitle} description={t.lede} canonicalPath={`/${locale}`} active="">
  <div class="wrap er-wrap">
    <div class="er-hanko">詫</div>
    <div class="ex-kicker" style="justify-content:center;">
      <svg width="28" height="8" viewBox="0 0 28 8"><path d="M1 4 Q 5 0, 9 4 T 17 4 T 27 4" stroke="var(--stamp)" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      500 · {t.kicker}
    </div>
    <h1 class="er-title">{t.head}</h1>
    <p class="er-lede">{t.lede}</p>
    <div class="er-cta">
      <a class="er-btn primary" href={path} data-er-retry>{t.retry}</a>
      <a class="er-btn ghost" href={`/${locale}`}>{t.home}</a>
    </div>
  </div>

  <!-- is:inline (NOT is:global): Astro externalizes is:global styles into a bundled
       CSS <link>, and the SSR error-fallback render path does not inject that link —
       so on a real 500 the page loses ALL styling (Shell tokens + these rules). Inline
       styles are emitted verbatim and always render. This block is therefore fully
       self-contained: it re-declares the design tokens + base reset it needs. -->
  <style is:inline>
    :root { --bg:#fbfaf7; --surface:#fff; --surface2:#f2f0eb; --ink:#1a1817; --inkSoft:#5c544c; --inkFaint:#a39f98; --line:#ece8e0; --accent:#f58fa3; --accentDeep:#e54e70; --stamp:#d63752; --tint:#fce5ea; --fontDisplay:'Shippori Mincho B1','Times New Roman',serif; --fontBody:'Inter','Noto Sans JP',system-ui,sans-serif; --fontMono:'JetBrains Mono',monospace; }
    :root[data-mode="dark"] { --bg:color-mix(in oklab,#f58fa3 7%,#15121a); --surface:color-mix(in oklab,#f58fa3 6%,#1e1b24); --surface2:color-mix(in oklab,#f58fa3 10%,#2a2632); --ink:#f4efea; --inkSoft:#b9b0bc; --inkFaint:#7e7588; --line:color-mix(in oklab,#f58fa3 12%,#342f3c); --tint:color-mix(in oklab,#f58fa3 20%,#1e1b24); color-scheme:dark; }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:var(--bg); color:var(--ink); font-family:var(--fontBody); -webkit-font-smoothing:antialiased; }
    a { color:inherit; text-decoration:none; }
    .wrap { max-width:1320px; margin:0 auto; padding:0 32px; }
    .ex-kicker { font-family:var(--fontMono); font-size:11px; color:var(--inkMeta); letter-spacing:0.18em; text-transform:uppercase; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .er-wrap { max-width: 680px; padding-top: 80px; padding-bottom: 96px; text-align: center; }
    .er-hanko { width: 104px; height: 104px; margin: 0 auto 28px; border-radius: 16%; border: 3px solid var(--stamp); color: var(--stamp); display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 700; font-size: 52px; transform: rotate(-6deg); }
    .er-title { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(34px, 5vw, 60px); letter-spacing: -0.025em; line-height: 1.08; color: var(--ink); margin: 6px 0 18px; text-wrap: pretty; }
    .er-lede { font-family: var(--fontDisplay); font-style: italic; font-size: clamp(17px, 2.2vw, 21px); color: var(--inkSoft); line-height: 1.5; margin: 0 auto 32px; max-width: 520px; }
    .er-cta { display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .er-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 999px; font-family: var(--fontBody); font-size: 14px; font-weight: 600; text-decoration: none; }
    .er-btn.primary { background: linear-gradient(135deg, var(--accent), var(--accentDeep)); color: #fff; }
    .er-btn.ghost { border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
    .er-btn.ghost:hover { border-color: var(--accent); }
  </style>
</Shell>
