---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.tsx';
interface Props { title?: string; locale?: 'ja' | 'en'; }
const { title = 'Nihon101 — 日本101', locale = 'ja' } = Astro.props;
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho+B1:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader locale={locale} client:load />
    <slot />
  </body>
</html>
