---
// Shell for the nihon101 mock SPA island. The proto UI is ported verbatim from
// the design-tool bundle into src/nihon/*. It is a client-only React island with
// its own hash routing + language toggle; SSR/SEO + real locale split is a later step.
import App from "../nihon/app.jsx";

interface Props {
  lang?: string;
  /** Sync the SPA's stored language with the page's URL locale before mount. */
  syncLang?: boolean;
}
const { lang = "ja", syncLang = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#D63752" />
    <title>nihon101 — 日本101</title>
    <meta
      name="description"
      content="A small bilingual magazine about Japan — culture, food, travel, language, animation, history. Read slowly."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&family=Zen+Old+Mincho:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        min-height: 100vh;
      }
      body {
        background: #fbfaf7;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        font-family: "Inter", "Noto Sans JP", system-ui, sans-serif;
      }
      button {
        font-family: inherit;
      }
      ::selection {
        background: #f58fa3;
        color: #fff;
      }
      /* responsive header (Nav island inline styles → !important beats them) */
      .nav-burger { display: none; }
      @keyframes navDrawerIn { from { transform: translateX(100%); } to { transform: none; } }
      /* tablet + phone (≤1280): collapse nav links + desktop actions behind the
         drawer; search stays in the bar and flexes to fill (Not Bagel pattern). */
      @media (max-width: 1280px) {
        .nihon-mainnav, .nav-hide-mobile { display: none !important; }
        .nav-burger { display: inline-flex !important; }
        /* search pill fills all free space, so the icon cluster ends at the right
           edge (the old `+ *` margin-auto pin hit the hidden .nav-search-toggle). */
        .nihon-searchwrap { flex: 1 1 auto !important; max-width: none !important; margin-right: 8px !important; }
        .nihon-search-kbd { display: none !important; }
        .nav-inner { gap: 10px !important; padding-left: 18px !important; padding-right: 18px !important; }
        /* any stray px of header overflow = horizontal scroll = the dark band on
           the right on phones (the browser zooms out to fit). Clip at the source. */
        body { overflow-x: clip; }
      }
      @media (max-width: 560px) {
        .nav-pop { position: fixed !important; left: 12px !important; right: 12px !important;
                   width: auto !important; max-width: none !important; }
        /* the row is logo + 4 fixed 38px icons: tighter gap/padding so it always
           fits — at gap 10/pad 16 it overflowed ~9px on 320px phones */
        .nav-inner { gap: 8px !important; padding-left: 12px !important; padding-right: 12px !important; }
        /* mobile: search collapses to an icon; the field only appears when tapped */
        .nihon-searchwrap { display: none !important; }
        /* with the search pill hidden nothing flexes, so pin the icon cluster to
           the right edge (same as tablet) instead of leaving a gap after it */
        .nav-search-toggle { display: inline-flex !important; margin-left: auto !important; }
        /* expanded: the field takes the whole row; every other icon is hidden */
        .nav-inner.nav-searching > * { display: none !important; }
        .nav-inner.nav-searching > .nihon-searchwrap { display: flex !important; flex: 1 1 auto !important; max-width: none !important; margin: 0 !important; }
        .nav-inner.nav-searching > .nav-search-close { display: inline-flex !important; }
      }
      @media (max-width: 380px) {
        .nav-inner { gap: 6px !important; padding-left: 10px !important; padding-right: 10px !important; }
      }
      /* SPA screen grids (inline gridTemplateColumns → !important beats them) */
      @media (max-width: 1024px) {
        .spa-g3 { grid-template-columns: repeat(2, 1fr) !important; }
        .spa-g4, .spa-g5 { grid-template-columns: repeat(3, 1fr) !important; }
      }
      @media (max-width: 820px) {
        .spa-g2, .spa-g3, .spa-split { grid-template-columns: 1fr !important; gap: 28px !important; }
        .spa-pad { padding-left: 16px !important; padding-right: 16px !important; padding-top: 40px !important; }
      }
      @media (max-width: 480px) {
        .spa-g4, .spa-g5 { grid-template-columns: 1fr 1fr !important; }
      }
      /* shared footer */
      @media (max-width: 820px) { .site-footer-grid { grid-template-columns: 1fr 1fr !important; gap: 28px !important; padding: 36px 16px 28px !important; } }
      @media (max-width: 440px) { .site-footer-grid { grid-template-columns: 1fr !important; } }
    </style>
  </head>
  <body>
    {syncLang && (
      <script is:inline define:vars={{ lang }}>
        // The SPA reads its language from localStorage ('jp'|'en'); keep it in
        // sync with the URL locale so /ja/app opens in Japanese.
        try {
          localStorage.setItem("nihon.lang", lang === "ja" ? "jp" : "en");
        } catch (e) {}
      </script>
    )}
    <App client:only="react" />
  </body>
</html>
