---
import '../styles/global.css';
import { authT, type Locale } from '../lib/i18n/auth';

interface Props { locale: Locale; title?: string }
const { locale, title = 'Nihon101' } = Astro.props;
const t = authT[locale];

// Same page, other locale — swap the leading /ja or /en segment.
const other: Locale = locale === 'ja' ? 'en' : 'ja';
const otherHref = Astro.url.pathname.replace(/^\/(ja|en)/, `/${other}`);
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Nihon101</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho+B1:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <!-- top bar -->
    <header class="flex items-center justify-between border-b border-line px-7 py-[18px]">
      <a href={`/${locale}/`} class="font-serif text-2xl font-bold text-ink">
        nihon<span class="text-hinomaru">101</span>
      </a>
      <div class="flex overflow-hidden rounded-full border border-line bg-white">
        <a
          href={locale === 'ja' ? Astro.url.pathname : otherHref}
          class={`px-3.5 py-1.5 text-[13px] font-semibold ${locale === 'ja' ? 'bg-hinomaru text-white' : 'text-mute'}`}
        >日本語</a>
        <a
          href={locale === 'en' ? Astro.url.pathname : otherHref}
          class={`px-3.5 py-1.5 text-[13px] font-semibold ${locale === 'en' ? 'bg-hinomaru text-white' : 'text-mute'}`}
        >EN</a>
      </div>
    </header>

    <!-- card -->
    <main class="flex flex-1 items-center justify-center px-5 py-10">
      <div
        class="w-full max-w-[400px] rounded-2xl border border-line bg-white px-[30px] py-[34px]"
        style="box-shadow:0 1px 3px rgba(0,0,0,.04),0 8px 30px rgba(0,0,0,.05)"
      >
        <slot />
      </div>
    </main>

    <div class="py-5 text-center text-[13px]">
      <a href={`/${locale}/`} class="text-mute transition hover:text-hinomaru">{t['backhome']}</a>
    </div>
  </body>
</html>
