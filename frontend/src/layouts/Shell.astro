---
// Shared SSR shell for the explore / category / tag pages — the same chrome
// (HomeHeader/HomeFooter islands), theme tokens, fonts, and the subset of the
// home page's card CSS (.wrap/.chip/.photo/.post-card/.sec-head) those pages reuse,
// plus the explore-specific bits (hero, search box, category strip, banner).
// Keeps the prototype design; pages only swap in real data.
import { HomeHeader, HomeFooter } from "../nihon/home-chrome.jsx";
import Toaster from "../components/Toaster.astro";
import Fonts from "../components/Fonts.astro";

interface Props {
  locale: string;
  title: string;
  description: string;
  canonicalPath: string; // e.g. "/en/search"
  active?: string;        // Nav item to highlight; default "search" (discovery pages)
  /** Absolute or site-relative share image; falls back to the branded OG card. */
  image?: string | null;
  /** 'website' (default) or 'article' for the post reader. */
  type?: 'website' | 'article';
  /** Article metadata (post pages) → article:* OG tags. */
  article?: { publishedTime?: string | null; modifiedTime?: string | null; author?: string | null; tags?: string[] } | null;
  /** Structured data object → emitted as an escaped <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown> | null;
  /** The page's LCP image (e.g. the article cover) — preloaded from the head so the
   *  browser starts it immediately instead of after the document parses. Must match
   *  the rendered <img> src/srcset/sizes exactly, or the browser downloads twice. */
  preload?: { href: string; srcset?: string; sizes?: string } | null;
}
const {
  locale, title, description, canonicalPath, active = "search",
  image = null, type = 'website', article = null, jsonLd = null, preload = null,
} = Astro.props as Props;
const jp = locale === 'ja';
const otherLocaleHref = `/${jp ? 'en' : 'ja'}${canonicalPath.replace(/^\/(en|ja)/, '')}`;

// Absolute canonical + share image (Astro.site = https://nihon101.com). An
// already-absolute cover URL passes through new URL() unchanged.
const base = Astro.site ?? new URL('https://nihon101.com');
const canonicalAbs = new URL(canonicalPath, base).href;
const ogImage = new URL(image || '/og-default.png', base).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Square favicons: Google requires 1:1 (96 = 48-multiple); /favicon.ico is the
        crawler fallback; the SVG serves crisp tabs in modern browsers. */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#D63752" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalAbs} />
    <link rel="alternate" hreflang={jp ? 'en' : 'ja'} href={`https://nihon101.com${otherLocaleHref}`} />
    <link rel="alternate" hreflang={locale} href={canonicalAbs} />
    {/* x-default = what a crawler should show a reader we have no locale for.
        Google treats a bilingual set without it as incomplete, and ja is the
        site's default (/ redirects there). */}
    <link rel="alternate" hreflang="x-default" href={`https://nihon101.com${jp ? canonicalPath : otherLocaleHref}`} />

    {/* Open Graph + Twitter share cards */}
    <meta property="og:site_name" content="nihon101" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbs} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={jp ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {type === 'article' && article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {type === 'article' && article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {type === 'article' && article?.author && <meta property="article:author" content={article.author} />}
    {type === 'article' && article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    {/* JSON-LD with `<` escaped — an unescaped post title could otherwise close the
        script tag and run markup for every visitor (the stored-XSS Not Bagel found
        in its production audit). */}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <script is:inline>
      try { var __m = localStorage.getItem('nihon.mode') || 'light'; document.documentElement.dataset.mode = __m; document.documentElement.style.colorScheme = __m === 'dark' ? 'dark' : 'light'; } catch (e) {}
    </script>
    <Fonts />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        fetchpriority="high"
      />
    )}
    <style is:global>
      :root {
        --bg: #fbfaf7; --surface: #fff; --surface2: #f2f0eb;
        --ink: #1a1817; --inkSoft: #5c544c; --inkFaint: #a39f98;
        /* Text twin of --inkFaint — see the note in [locale]/index.astro. Faint
           stays for hairlines/icon strokes; anything with words in it uses this. */
        --inkMeta: #6f6960;
        --line: #ece8e0; --accent: #f58fa3; --accentDeep: #e54e70;
        --stamp: #d63752; --tint: #fce5ea;
        --fontDisplay: 'Shippori Mincho B1', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
        --fontBody: 'Inter', 'Noto Sans JP', system-ui, sans-serif;
        --fontMono: 'JetBrains Mono', monospace;
      }
      :root[data-mode="dark"] {
        --bg: color-mix(in oklab, #f58fa3 7%, #15121a);
        --surface: color-mix(in oklab, #f58fa3 6%, #1e1b24);
        --surface2: color-mix(in oklab, #f58fa3 10%, #2a2632);
        --ink: #f4efea; --inkSoft: #b9b0bc; --inkFaint: #7e7588; --inkMeta: #9d94a8;
        --line: color-mix(in oklab, #f58fa3 12%, #342f3c);
        --tint: color-mix(in oklab, #f58fa3 20%, #1e1b24);
        color-scheme: dark;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: var(--bg); color: var(--ink); font-family: var(--fontBody); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
      /* Proportional-alternate widths tighten Japanese kana/punctuation on display
         headings (a no-op on Latin glyphs, so EN headlines are untouched). */
      h1, h2, h3 { font-feature-settings: "palt" 1; }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; }
      ::selection { background: #f58fa3; color: #fff; }
      .wrap { max-width: 1320px; margin: 0 auto; padding: 0 32px; }

      /* explore / banner hero */
      .ex-kicker { font-family: var(--fontMono); font-size: 11px; color: var(--inkMeta); letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
      .ex-kicker .wave { display: inline-block; width: 28px; height: 8px; }
      h1.ex { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(40px, 5vw, 72px); letter-spacing: -0.025em; line-height: 1.05; color: var(--ink); margin-bottom: 8px; text-wrap: pretty; }
      .ex-sub { font-family: var(--fontDisplay); font-style: italic; font-size: 20px; color: var(--inkSoft); margin-bottom: 32px; }

      /* big search box on the explore page */
      .ex-search { display: flex; align-items: center; gap: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 14px 22px; margin-bottom: 20px; }
      .ex-search:focus-within { border-color: var(--accent); }
      .ex-search input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; font-family: var(--fontDisplay); font-size: 22px; color: var(--ink); }
      .ex-search svg { flex: none; stroke: var(--ink); fill: none; stroke-width: 2; }
      .ex-search button { appearance: none; border: none; background: transparent; cursor: pointer; color: var(--inkMeta); font-family: var(--fontMono); font-size: 12px; }

      /* category filter strip */
      .cat-strip { display: flex; flex-wrap: wrap; gap: 10px; }
      .cat-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-size: 13px; font-weight: 600; color: var(--inkSoft); cursor: pointer; }
      .cat-pill .kj { font-family: var(--fontDisplay); color: var(--stamp); }
      .cat-pill.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
      .cat-pill.on .kj { color: var(--accent); }

      .results-count { font-family: var(--fontMono); font-size: 11px; color: var(--inkMeta); letter-spacing: 0.1em; text-transform: uppercase; margin: 24px 0 16px; }

      /* sort toggle + count row */
      .list-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 24px 0 18px; }
      .list-bar .results-count { margin: 0; }
      .sortbar { display: inline-flex; gap: 6px; background: var(--surface2); border-radius: 999px; padding: 4px; }
      .sort-pill { padding: 7px 15px; border-radius: 999px; font-size: 13px; font-weight: 600; color: var(--inkSoft); white-space: nowrap; }
      .sort-pill.on { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px color-mix(in oklab, var(--ink) 12%, transparent); }

      /* skeleton loading */
      @keyframes skelShimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
      .skel { background: linear-gradient(90deg, color-mix(in oklab, var(--ink) 7%, transparent) 25%, color-mix(in oklab, var(--ink) 13%, transparent) 37%, color-mix(in oklab, var(--ink) 7%, transparent) 63%); background-size: 200% 100%; animation: skelShimmer 1.4s ease-in-out infinite; border-radius: 8px; }
      @media (prefers-reduced-motion: reduce) { .skel { animation: none; } }

      /* pagination */
      .pager { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 56px 0 8px; flex-wrap: wrap; }
      .pager a { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-size: 14px; font-weight: 600; color: var(--ink); }
      .pager a:hover { border-color: var(--accent); }
      .pager .pg-num.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
      .pager .pg-gap { color: var(--inkMeta); padding: 0 4px; }

      /* author results (text search) */
      .author-results { margin-top: 28px; }
      .author-row { display: flex; flex-wrap: wrap; gap: 12px; }
      .author-chip { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px 8px 8px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); transition: transform 0.15s ease; }
      .author-chip:hover { transform: translateY(-2px); }
      .author-chip .ava { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex: none; display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 600; font-size: 14px; color: #3a2e28; border: 1px solid var(--line); }
      .author-chip .ava img { width: 100%; height: 100%; object-fit: cover; }
      .author-chip .who { display: flex; flex-direction: column; line-height: 1.2; }
      .author-chip .who b { font-family: var(--fontBody); font-size: 14px; font-weight: 600; color: var(--ink); }
      .author-chip .who .at { font-family: var(--fontMono); font-size: 11px; color: var(--inkMeta); }

      /* category banner */
      .banner { border-bottom: 1px solid var(--line); }
      .banner .wrap { padding: 64px 32px 48px; display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; }
      .banner .hanko { width: 96px; height: 96px; border-radius: 16%; border: 3px solid var(--stamp); color: var(--stamp); display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 700; font-size: 46px; transform: rotate(-6deg); flex: none; }
      .banner h1 { font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(40px, 5vw, 72px); letter-spacing: -0.025em; line-height: 1; color: var(--ink); }
      .banner h1 .alt { color: var(--inkMeta); font-size: 0.4em; margin-left: 14px; letter-spacing: 0.05em; }
      .banner .blurb { font-family: var(--fontDisplay); font-style: italic; font-size: 20px; color: var(--inkSoft); margin-top: 12px; max-width: 640px; }

      /* shared card grid (mirrors index.astro) */
      .recent-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
      .post-card { display: flex; flex-direction: column; gap: 12px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 22px; padding: 14px; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
      .post-card:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--accent) 55%, var(--line)); box-shadow: 0 18px 30px -22px color-mix(in oklab, var(--accentDeep) 45%, transparent); }
      .post-card .cmeta { display: flex; align-items: center; gap: 10px; }
      .post-card .mins { font-family: var(--fontMono); font-size: 11px; color: var(--inkMeta); letter-spacing: 0.06em; }
      .post-card h3 { font-family: var(--fontDisplay); font-weight: 600; font-size: 22px; line-height: 1.15; letter-spacing: -0.015em; text-wrap: pretty; }
      .post-card .ex { font-size: 14px; line-height: 1.55; color: var(--inkSoft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .card-tags { display: flex; flex-wrap: wrap; gap: 6px; }
      .card-tags .tag { display: inline-flex; align-items: center; gap: 1px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-size: 11px; font-weight: 500; color: var(--inkSoft); }
      .card-tags .tag .h { color: var(--accent); font-weight: 800; }
      .post-card .foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); gap: 12px; }
      .post-card .foot .dt { font-size: 12px; color: var(--inkMeta); }
      .post-card .stats { display: flex; align-items: center; gap: 14px; flex: none; }
      .post-card .stat { display: inline-flex; align-items: center; gap: 5px; font-family: var(--fontMono); font-size: 12.5px; font-weight: 600; color: var(--inkSoft); }
      .post-card .stat svg { width: 15px; height: 15px; }
      /* outline heart by default; only a heart the viewer actually liked fills red
         (hydrated client-side via /posts/liked-state after the session resolves). */
      .post-card .stat.heart svg { fill: none; stroke: var(--inkFaint); stroke-width: 2; stroke-linejoin: round; }
      .post-card .stat.heart.liked svg { fill: var(--stamp); stroke: none; }
      .post-card .stat.heart.liked { color: var(--stamp); }
      .post-card .stat.chat svg { fill: none; stroke: var(--inkFaint); stroke-width: 2; stroke-linejoin: round; }
      .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; border: 1px solid var(--line); background: var(--surface); }
      .chip .kanji { font-family: var(--fontDisplay); color: var(--stamp); text-transform: none; letter-spacing: 0; }
      .achip { display: inline-flex; align-items: center; gap: 10px; }
      .achip .ava { border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 600; border: 1px solid var(--line); color: #3a2e28; overflow: hidden; flex-shrink: 0; }
      .achip .ava img { width: 100%; height: 100%; object-fit: cover; }
      .achip .nm { font-size: 13px; font-weight: 600; color: var(--ink); }
      .achip .dt { font-size: 11px; color: var(--inkMeta); }
      .photo { position: relative; width: 100%; border-radius: 14px; overflow: hidden; display: block; }
      .photo .glyph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--fontDisplay); font-weight: 600; font-size: clamp(90px, 22%, 240px); color: rgba(255, 255, 255, 0.6); line-height: 1; user-select: none; pointer-events: none; letter-spacing: -0.04em; }
      .photo img { width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0; }
      .photo .vignette { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,0.35) 115%); opacity: 0.22; pointer-events: none; }
      .photo-tag { position: absolute; left: 14px; bottom: 12px; display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(6px); padding: 5px 10px; border-radius: 999px; font-family: var(--fontMono); font-size: 10px; letter-spacing: 0.08em; color: var(--inkSoft); text-transform: uppercase; }
      .photo-tag .dot { width: 6px; height: 6px; border-radius: 3px; background: var(--stamp); display: inline-block; }

      .empty { padding: 80px 0; text-align: center; }
      .empty .mu { font-family: var(--fontDisplay); font-size: 48px; color: var(--stamp); margin-bottom: 8px; }
      .empty .msg { font-family: var(--fontDisplay); font-style: italic; font-size: 22px; color: var(--inkSoft); }

      /* vertical only — must NOT reset the horizontal gutter that .wrap sets
         (these pages use class="wrap section"; a `padding` shorthand here would
         zero .wrap's left/right padding and make content touch the screen edge). */
      .section { padding-top: 48px; padding-bottom: 96px; }

      /* ---- responsive header (Nav island uses inline styles → !important beats them) ---- */
      .nav-burger { display: none; }
      @keyframes navDrawerIn { from { transform: translateX(100%); } to { transform: none; } }
      /* tablet + phone (≤1280): collapse the nav links + desktop actions behind the
         drawer; the search pill STAYS in the bar and flexes to fill the freed row. */
      @media (max-width: 1280px) {
        .nihon-mainnav, .nav-hide-mobile { display: none !important; }
        .nav-burger { display: inline-flex !important; }
        /* search pill fills all free space, so the icon cluster ends at the right
           edge (the old `+ *` margin-auto pin hit the hidden .nav-search-toggle). */
        .nihon-searchwrap { flex: 1 1 auto !important; max-width: none !important; margin-right: 8px !important; }
        .nihon-search-kbd { display: none !important; }
        .nav-inner { gap: 10px !important; padding-left: 18px !important; padding-right: 18px !important; }
        /* any stray px of header overflow = horizontal scroll = the dark band on
           the right on phones (the browser zooms out to fit). Clip at the source. */
        body { overflow-x: clip; }
      }
      /* header popovers (notifications / account / search) become an anchored
         full-width sheet on phones instead of a 360px box that runs off-screen. */
      @media (max-width: 560px) {
        .nav-pop { position: fixed !important; left: 12px !important; right: 12px !important;
                   width: auto !important; max-width: none !important; }
        /* the row is logo + 4 fixed 38px icons: tighter gap/padding so it always
           fits — at gap 10/pad 16 it overflowed ~9px on 320px phones */
        .nav-inner { gap: 8px !important; padding-left: 12px !important; padding-right: 12px !important; }
        /* mobile: search collapses to an icon; the field only appears when tapped */
        .nihon-searchwrap { display: none !important; }
        /* with the search pill hidden nothing flexes, so pin the icon cluster to
           the right edge (same as tablet) instead of leaving a gap after it */
        .nav-search-toggle { display: inline-flex !important; margin-left: auto !important; }
        /* expanded: the field takes the whole row; every other icon is hidden */
        .nav-inner.nav-searching > * { display: none !important; }
        .nav-inner.nav-searching > .nihon-searchwrap { display: flex !important; flex: 1 1 auto !important; max-width: none !important; margin: 0 !important; }
        .nav-inner.nav-searching > .nav-search-close { display: inline-flex !important; }
      }
      @media (max-width: 380px) {
        .nav-inner { gap: 6px !important; padding-left: 10px !important; padding-right: 10px !important; }
      }
      @media (max-width: 820px) { .site-footer-grid { grid-template-columns: 1fr 1fr !important; gap: 28px !important; padding: 36px 16px 28px !important; } }
      @media (max-width: 440px) { .site-footer-grid { grid-template-columns: 1fr !important; } }
      /* SPA-island grids that also render on Shell pages (e.g. the feed on /for-you) */
      @media (max-width: 1024px) {
        .spa-g3 { grid-template-columns: repeat(2, 1fr) !important; }
        .spa-g4, .spa-g5 { grid-template-columns: repeat(3, 1fr) !important; }
      }
      @media (max-width: 820px) {
        .spa-g2, .spa-g3, .spa-split { grid-template-columns: 1fr !important; gap: 28px !important; }
        .spa-pad { padding-left: 16px !important; padding-right: 16px !important; padding-top: 40px !important; }
      }
      @media (max-width: 480px) {
        .spa-g4, .spa-g5 { grid-template-columns: 1fr 1fr !important; }
      }

      /* ---- responsive: tablet ---- */
      @media (max-width: 1024px) {
        .wrap { padding: 0 24px; }
        .recent-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
        .banner .wrap { padding: 52px 24px 40px; gap: 22px; }
      }
      /* ---- responsive: mobile ---- */
      @media (max-width: 640px) {
        .wrap { padding: 0 20px; }
        .recent-grid { grid-template-columns: 1fr; gap: 20px; }
        .section { padding-top: 32px; padding-bottom: 64px; }
        .banner .wrap { grid-template-columns: 1fr; gap: 16px; padding: 36px 16px 30px; }
        .banner .hanko { width: 68px; height: 68px; font-size: 32px; }
        .banner .blurb { font-size: 16px; }
        h1.ex { font-size: clamp(32px, 9vw, 44px); }
        .ex-sub { font-size: 16px; margin-bottom: 24px; }
        .ex-search { padding: 11px 16px; gap: 10px; margin-bottom: 16px; }
        .ex-search input { font-size: 17px; }
        .list-bar { margin: 18px 0 14px; }
        .pager { margin: 40px 0 8px; }
        .pager a { min-width: 36px; height: 36px; }
      }
    </style>
  </head>
  <body>
    {/* Idle hydration — see the note in [locale]/index.astro. */}
    <HomeHeader client:idle locale={locale} active={active} />
    <slot />
    {/* client:idle, NOT client:visible. The footer's inner text colours come from
        the JS palette object, and the SSR pass always renders the light one (see
        HomeFooter — it starts 'light' to match SSR, then corrects on mount). Under
        client:visible that correction waits for the reader to scroll the footer
        into view, so a dark-mode visitor scrolls down into #1A1817 text on a dark
        background — 1.19:1, unreadable — which then flips to dark as they watch.
        client:idle keeps the hydration off the critical path but fixes the theme
        moments after load, long before anyone reaches the bottom of the page. */}
    <HomeFooter client:idle locale={locale} />
    <Toaster />
  </body>
</html>
