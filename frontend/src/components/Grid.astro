---
// Reusable SSR card grid — renders the home page's `.post-card` markup for a list
// of post-cards. Used by the explore / category / tag / profile pages. Cards link
// articles into the SSR reader (/{locale}/p/slug), categories to the SSR
// category page, authors to their profile. `hideAuthor` drops the byline (profile
// page, where every card is the same author) and shows the date instead.
import { makeHelpers, tagSlug, type CatLike } from "../lib/cards";

interface Props {
  posts: any[];
  categories: CatLike[];
  locale: string;
  hideAuthor?: boolean;
}
const { posts, categories, locale, hideAuthor = false } = Astro.props as Props;
const jp = locale === 'ja';
const h = makeHelpers(categories, jp);
const readHref = (po: any) => `/${locale}/p/${po.slug}`;
const HEART = "M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z";
const CHAT = "M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z";
---
<div class="recent-grid">
  {posts.map((po: any) => (
    <article class="post-card">
      <a class="photo" style={`height:240px;${po.cover ? '' : `background:linear-gradient(135deg, ${h.grad(po.categoryId)[0]}, ${h.grad(po.categoryId)[1]});`}`} href={readHref(po)}>
        {po.cover ? <img src={po.cover} alt={h.title(po)} loading="lazy" /> : <span class="glyph" style="font-size:84px;">{h.glyphFor(po.categoryId)}</span>}
        <span class="vignette"></span>
        {po.coverLabel && <span class="photo-tag"><span class="dot"></span> photo: {po.coverLabel}</span>}
      </a>
      <div class="cmeta">
        <a class="chip" href={`/${locale}/c/${po.categoryId}`}>
          <span class="kanji">{h.catKanji(po.categoryId)}</span>
          {h.catLabel(po.categoryId)}
        </a>
        <span class="mins">{po.readMins} min</span>
      </div>
      <a href={readHref(po)}><h3>{h.title(po)}</h3></a>
      <p class="ex">{h.excerpt(po)}</p>
      {po.tags && po.tags.length > 0 && (
        <div class="card-tags">
          {po.tags.slice(0, 3).map((tg: string) => (
            <a class="tag" href={`/${locale}/t/${tagSlug(tg)}`}><span class="h">#</span>{tg}</a>
          ))}
        </div>
      )}
      <div class="foot">
        {hideAuthor ? (
          <span class="dt">{h.dateFmt(po.publishedAt ?? po.createdAt)}</span>
        ) : (
          <a class="achip" href={po.authorHandle ? `/${locale}/u/${po.authorHandle}` : readHref(po)}>
            <span class="ava" style={`width:26px;height:26px;font-size:11px;overflow:hidden;background:linear-gradient(135deg, ${h.tintOf(po.authorHandle)}, #f2f0eb);`}>
              {po.authorAvatarUrl ? <img src={po.authorAvatarUrl} alt="" style="width:100%;height:100%;object-fit:cover;" /> : h.initialsOf(po.authorName || '?')}
            </span>
            <span>
              <span class="nm" style="font-size:12.5px;">{h.authorName(po)}</span><br />
              <span class="dt">{h.dateFmt(po.publishedAt ?? po.createdAt)}</span>
            </span>
          </a>
        )}
        <div class="stats">
          <span class="stat heart" data-like={po.id}><svg viewBox="0 0 24 24"><path d={HEART}></path></svg>{po.likes.toLocaleString()}</span>
          <span class="stat chat"><svg viewBox="0 0 24 24"><path d={CHAT}></path></svg>{(po.comments ?? 0).toLocaleString()}</span>
        </div>
      </div>
    </article>
  ))}
</div>
